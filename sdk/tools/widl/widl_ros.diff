+        UINT len = make_type_sig( type, sig );
+        return add_typespec_row( add_blob( sig, len ) ) << 2 | 2;
+    }
+    if (type->md.spec) return type->md.spec << 2 | 2;
+    return type->md.ref << 2 | 1;
+}
