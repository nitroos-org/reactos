+
+        LIST_FOR_EACH_ENTRY( stmt, import_stmts[i].stmts, const statement_t, entry )
+        {
+            type_t *type;
+
+            if (step == 2 && stmt->type == STMT_TYPEDEF)
+            {
+                const typeref_t *ref;
+
+                if (stmt->u.type_list) LIST_FOR_EACH_ENTRY( ref, stmt->u.type_list, const typeref_t, entry )
+                {
