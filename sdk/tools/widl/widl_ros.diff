+    if (stmt->type == STMT_TYPEDEF && stmt->u.type_list)
+    {
+        const typeref_t *ref;
+
+        LIST_FOR_EACH_ENTRY( ref, stmt->u.type_list, const typeref_t, entry )
+        {
+            type_t *type = type_get_real_type( ref->type );
