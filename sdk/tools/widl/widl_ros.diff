+                else if (!type->md.def) add_enum_type_step2( type );
+                break;
+            case TYPE_STRUCT:
+                if (step == 1) { type->written = 1; add_struct_type_step1( type ); }
+                else if (!type->md.def) add_struct_type_step2( type );
+                break;
+            case TYPE_INTERFACE:
