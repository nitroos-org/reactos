+void record_import_statements( const char *name, statement_list_t *stmts )
+{
+    if (!stmts) return;
+    import_stmts = xrealloc( import_stmts, (import_stmts_count + 1) * sizeof(*import_stmts) );
+    import_stmts[import_stmts_count].name = xstrdup( name );
+    import_stmts[import_stmts_count].stmts = stmts;
+    import_stmts_count++;
