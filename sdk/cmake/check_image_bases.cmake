# i386 image base check: every based system DLL must occupy its own [ImageBase, ImageBase + SizeOfImage) range, and the DLLs
# loaded below ntdll must end at least MIN_HEADROOM bytes under ntdll's base so locale/resource growth cannot reach it.
# Run with -DLIST=<file of "name|path" lines> -DNTDLL_BASE=<hex> -DMIN_HEADROOM=<hex> [-DWARN_ONLY=ON].
# The ranges are read from the PE headers of the linked images, so this holds whichever toolchain or base table was used.

function(_read_u32 HEX OFFSET OUTVAR)
    math(EXPR _pos "${OFFSET} * 2")
    string(SUBSTRING "${HEX}" ${_pos} 8 _le)
    string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" _be "${_le}")
    math(EXPR _v "0x${_be}")
    set(${OUTVAR} ${_v} PARENT_SCOPE)
endfunction()

file(STRINGS "${LIST}" _lines)
set(_names "")
foreach(_line ${_lines})
    if(NOT _line MATCHES "^([^|]+)\\|(.+)$")
        continue()
    endif()
    set(_name "${CMAKE_MATCH_1}")
    set(_path "${CMAKE_MATCH_2}")
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "check_image_bases: ${_path} (${_name}) does not exist")
    endif()
    file(READ "${_path}" _hdr LIMIT 1024 HEX)
    _read_u32("${_hdr}" 60 _lfanew)
    math(EXPR _opt "${_lfanew} + 24")
    _read_u32("${_hdr}" ${_opt} _magic_dw)
    math(EXPR _magic "${_magic_dw} & 0xFFFF")
    if(NOT _magic EQUAL 0x10b)
        message(FATAL_ERROR "check_image_bases: ${_name} is not a PE32 image (optional header magic ${_magic})")
    endif()
    math(EXPR _o_base "${_opt} + 28")
    math(EXPR _o_size "${_opt} + 56")
    _read_u32("${_hdr}" ${_o_base} _base)
    _read_u32("${_hdr}" ${_o_size} _size)
    math(EXPR _end "${_base} + ${_size}")
    get_filename_component(_file "${_path}" NAME)
    set(file_${_name} "${_file}")
    set(base_${_name} ${_base})
    set(end_${_name} ${_end})
    list(APPEND _names ${_name})
endforeach()

math(EXPR _ntdll "${NTDLL_BASE}")
math(EXPR _minh "${MIN_HEADROOM}")
set(_errors "")
set(_min_room "")
list(LENGTH _names _n)
math(EXPR _last "${_n} - 1")
foreach(_i RANGE 0 ${_last})
    list(GET _names ${_i} _a)
    math(EXPR _next "${_i} + 1")
    if(_next LESS _n)
        foreach(_j RANGE ${_next} ${_last})
            list(GET _names ${_j} _b)
            # Modules that build the same file (fusion, fusion_1_1, fusion_2_0) are alternatives: only one is ever installed
            if(NOT file_${_a} STREQUAL file_${_b} AND base_${_a} LESS end_${_b} AND base_${_b} LESS end_${_a})
                string(APPEND _errors "  ${_a} [${base_${_a}}..${end_${_a}}) overlaps ${_b} [${base_${_b}}..${end_${_b}}) (decimal addresses)\n")
            endif()
        endforeach()
    endif()
    # Headroom below ntdll; ntdll and its companion ntdll_vista are placed against it on purpose
    if(NOT _a MATCHES "^ntdll" AND base_${_a} LESS _ntdll)
        math(EXPR _room "${_ntdll} - ${end_${_a}}")
        if(_room LESS _minh)
            string(APPEND _errors "  ${_a} ends only ${_room} bytes below ntdll (need ${_minh})\n")
        endif()
        if(_min_room STREQUAL "" OR _room LESS _min_room)
            set(_min_room ${_room})
            set(_min_name ${_a})
        endif()
    endif()
endforeach()

if(_errors AND WARN_ONLY)
    message(WARNING "i386 image base check (report only for this toolchain):\n${_errors}")
elseif(_errors)
    message(FATAL_ERROR "i386 image base check failed. Re-plan the base table (sdk/cmake/baseaddress*.cmake, see its header):\n${_errors}")
endif()
math(EXPR _kb "${_min_room} / 1024")
message(STATUS "Image bases: ${_n} DLLs, no overlap; tightest gap to ntdll: ${_min_name} (${_kb} KB)")
