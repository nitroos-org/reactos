# NITRO_PDB_PUBLICS: write the manifest of the PDB files next to the build output.
# Run with -DLIST=<file of "image|pdb" lines> -DPDB_ROOT=<the pdb directory> -DOUT=<manifest file>.
# One line per image, tab separated: image name, image size, TimeDateStamp (hex), PDB name from the CodeView record, PDB GUID,
# age, symbol store key (<PDB name>/<GUID without dashes><age in hex>), sha256 of the image, size of the PDB, sha256 of the PDB,
# path of the PDB file relative to the pdb directory (several modules can have the same file name: the directory tells them apart),
# the name the image has when it is installed (ntkrnlmp.exe is installed as ntoskrnl.exe, halmp.dll as hal.dll ...), and the key of
# the image in a symbol store: <TimeDateStamp as 8 upper case hex digits><SizeOfImage in lower case hex>.
# The CodeView (RSDS) record is read from the debug directory of the linked image. An image without one, or whose record does not
# name the PDB that was written, fails the build: a PDB that cannot be matched to its image is worth nothing.

function(_u32 HEX OFFSET OUTVAR)
    math(EXPR _pos "${OFFSET} * 2")
    string(SUBSTRING "${HEX}" ${_pos} 8 _le)
    string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" _be "${_le}")
    math(EXPR _v "0x${_be}")
    set(${OUTVAR} ${_v} PARENT_SCOPE)
endfunction()

function(_u16 HEX OFFSET OUTVAR)
    math(EXPR _pos "${OFFSET} * 2")
    string(SUBSTRING "${HEX}" ${_pos} 4 _le)
    string(REGEX REPLACE "(..)(..)" "\\2\\1" _be "${_le}")
    math(EXPR _v "0x${_be}")
    set(${OUTVAR} ${_v} PARENT_SCOPE)
endfunction()

# hex bytes [FROM, FROM+COUNT) of HEX, in reverse order
function(_rev HEX FROM COUNT OUTVAR)
    math(EXPR _pos "${FROM} * 2")
    math(EXPR _len "${COUNT} * 2")
    string(SUBSTRING "${HEX}" ${_pos} ${_len} _s)
    set(_r "")
    foreach(_i RANGE 1 ${COUNT})
        string(SUBSTRING "${_s}" 0 2 _b)
        string(SUBSTRING "${_s}" 2 -1 _s)
        set(_r "${_b}${_r}")
    endforeach()
    set(${OUTVAR} "${_r}" PARENT_SCOPE)
endfunction()

file(STRINGS "${LIST}" _lines)
set(_out "# image\tsize\ttimestamp\tpdb\tguid\tage\tsymstore-key\timage-sha256\tpdb-size\tpdb-sha256\tpdb-path\tinstall-name\timage-key\n")
foreach(_line ${_lines})
    if(NOT _line MATCHES "^([^|]+)\\|(.+)$")
        continue()
    endif()
    set(_img "${CMAKE_MATCH_1}")
    set(_pdb "${CMAKE_MATCH_2}")
    get_filename_component(_name "${_img}" NAME)
    get_filename_component(_pdbname "${_pdb}" NAME)
    if(NOT EXISTS "${_img}")
        message(FATAL_ERROR "pdb_manifest: ${_img} does not exist")
    endif()
    if(NOT EXISTS "${_pdb}")
        message(FATAL_ERROR "pdb_manifest: ${_pdb} (PDB of ${_name}) was not written")
    endif()

    # headers
    file(READ "${_img}" _hdr LIMIT 4096 HEX)
    _u32("${_hdr}" 60 _lfanew)
    math(EXPR _coff "${_lfanew} + 4")
    math(EXPR _o "${_coff} + 2")
    _u16("${_hdr}" ${_o} _nsec)
    math(EXPR _o "${_coff} + 4")
    _u32("${_hdr}" ${_o} _stamp)
    math(EXPR _o "${_coff} + 16")
    _u16("${_hdr}" ${_o} _optsize)
    math(EXPR _opt "${_coff} + 20")
    _u16("${_hdr}" ${_opt} _magic)
    if(_magic EQUAL 0x10b)
        math(EXPR _dd "${_opt} + 96")
    elseif(_magic EQUAL 0x20b)
        math(EXPR _dd "${_opt} + 112")
    else()
        message(FATAL_ERROR "pdb_manifest: ${_name}: not a PE32/PE32+ image")
    endif()
    math(EXPR _o "${_dd} + 6 * 8")
    _u32("${_hdr}" ${_o} _dbg_rva)
    math(EXPR _o "${_dd} + 6 * 8 + 4")
    _u32("${_hdr}" ${_o} _dbg_size)
    if(_dbg_rva EQUAL 0)
        message(FATAL_ERROR "pdb_manifest: ${_name} has no debug directory (no CodeView record for ${_pdbname})")
    endif()

    # RVA -> file offset
    set(_dbg_off -1)
    math(EXPR _sec "${_opt} + ${_optsize}")
    math(EXPR _last "${_nsec} - 1")
    foreach(_i RANGE 0 ${_last})
        math(EXPR _s "${_sec} + ${_i} * 40")
        math(EXPR _o "${_s} + 8")
        _u32("${_hdr}" ${_o} _vsize)
        math(EXPR _o "${_s} + 12")
        _u32("${_hdr}" ${_o} _va)
        math(EXPR _o "${_s} + 16")
        _u32("${_hdr}" ${_o} _rawsize)
        math(EXPR _o "${_s} + 20")
        _u32("${_hdr}" ${_o} _rawptr)
        if(_vsize LESS _rawsize)
            set(_vsize ${_rawsize})
        endif()
        math(EXPR _end "${_va} + ${_vsize}")
        if(_dbg_rva GREATER_EQUAL _va AND _dbg_rva LESS _end)
            math(EXPR _dbg_off "${_rawptr} + ${_dbg_rva} - ${_va}")
        endif()
    endforeach()
    if(_dbg_off LESS 0)
        message(FATAL_ERROR "pdb_manifest: ${_name}: debug directory RVA 0x${_dbg_rva} is in no section")
    endif()

    # the CodeView entry of the debug directory (type 2)
    file(READ "${_img}" _dir OFFSET ${_dbg_off} LIMIT ${_dbg_size} HEX)
    math(EXPR _n "${_dbg_size} / 28")
    set(_cv_off -1)
    set(_cv_size 0)
    foreach(_i RANGE 0 ${_n})
        if(_i EQUAL _n)
            break()
        endif()
        math(EXPR _e "${_i} * 28")
        math(EXPR _o "${_e} + 12")
        _u32("${_dir}" ${_o} _type)
        if(_type EQUAL 2)
            math(EXPR _o "${_e} + 16")
            _u32("${_dir}" ${_o} _cv_size)
            math(EXPR _o "${_e} + 24")
            _u32("${_dir}" ${_o} _cv_off)
        endif()
    endforeach()
    if(_cv_off LESS 0)
        message(FATAL_ERROR "pdb_manifest: ${_name}: no CodeView entry in the debug directory")
    endif()
    file(READ "${_img}" _cv OFFSET ${_cv_off} LIMIT ${_cv_size} HEX)
    string(SUBSTRING "${_cv}" 0 8 _sig)
    if(NOT _sig STREQUAL "52534453")
        message(FATAL_ERROR "pdb_manifest: ${_name}: CodeView record is not RSDS")
    endif()
    _rev("${_cv}" 4 4 _g1)
    _rev("${_cv}" 8 2 _g2)
    _rev("${_cv}" 10 2 _g3)
    string(SUBSTRING "${_cv}" 24 4 _g4)
    string(SUBSTRING "${_cv}" 28 12 _g5)
    string(TOUPPER "${_g1}-${_g2}-${_g3}-${_g4}-${_g5}" _guid)
    string(TOUPPER "${_g1}${_g2}${_g3}${_g4}${_g5}" _guidkey)
    _u32("${_cv}" 20 _age)
    math(EXPR _age_hex "${_age}" OUTPUT_FORMAT HEXADECIMAL)
    string(REGEX REPLACE "^0x" "" _age_hex "${_age_hex}")
    string(TOUPPER "${_age_hex}" _age_hex)

    # the PDB name in the record: a bare file name (no build or host path), and it is the PDB that was written
    set(_cvname "")
    math(EXPR _nbytes "${_cv_size} - 24")
    foreach(_i RANGE 0 ${_nbytes})
        if(_i EQUAL _nbytes)
            break()
        endif()
        math(EXPR _p "(24 + ${_i}) * 2")
        string(SUBSTRING "${_cv}" ${_p} 2 _b)
        if(_b STREQUAL "00")
            break()
        endif()
        math(EXPR _code "0x${_b}")
        string(ASCII ${_code} _ch)
        string(APPEND _cvname "${_ch}")
    endforeach()
    if(NOT _cvname STREQUAL _pdbname)
        message(FATAL_ERROR "pdb_manifest: ${_name}: CodeView record names '${_cvname}', the PDB written is '${_pdbname}'")
    endif()

    math(EXPR _stamp_hex "${_stamp}" OUTPUT_FORMAT HEXADECIMAL)
    string(REGEX REPLACE "^0x" "" _stamp_key "${_stamp_hex}")
    string(TOUPPER "${_stamp_key}" _stamp_key)
    string(LENGTH "${_stamp_key}" _sk_len)
    while(_sk_len LESS 8)
        set(_stamp_key "0${_stamp_key}")
        math(EXPR _sk_len "${_sk_len} + 1")
    endwhile()
    math(EXPR _o "${_opt} + 56")
    _u32("${_hdr}" ${_o} _soi)
    math(EXPR _soi_hex "${_soi}" OUTPUT_FORMAT HEXADECIMAL)
    string(REGEX REPLACE "^0x" "" _soi_hex "${_soi_hex}")
    # images that the installer renames
    set(_install "${_name}")
    if(_name STREQUAL "ntkrnlmp.exe")
        set(_install "ntoskrnl.exe")
    elseif(_name STREQUAL "halmp.dll")
        set(_install "hal.dll")
    elseif(_name STREQUAL "kdcomkit.dll")
        set(_install "kdcom.dll")
    endif()
    file(SIZE "${_img}" _isize)
    file(SIZE "${_pdb}" _psize)
    file(SHA256 "${_img}" _ihash)
    file(SHA256 "${_pdb}" _phash)
    file(RELATIVE_PATH _pdbrel "${PDB_ROOT}" "${_pdb}")
    string(APPEND _out "${_name}\t${_isize}\t${_stamp_hex}\t${_cvname}\t${_guid}\t${_age}\t${_pdbname}/${_guidkey}${_age_hex}\t${_ihash}\t${_psize}\t${_phash}\t${_pdbrel}\t${_install}\t${_stamp_key}${_soi_hex}\n")
endforeach()
file(WRITE "${OUT}" "${_out}")
message(STATUS "pdb_manifest: ${OUT}")
