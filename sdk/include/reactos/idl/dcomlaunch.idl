import "wtypes.idl";

cpp_quote("#define DCOMLAUNCH_START_PROTSEQ L\"ncalrpc\"")
cpp_quote("#define DCOMLAUNCH_START_ENDPOINT L\"dcomlaunch_svcstart\"")

[
    uuid(92171bc0-63d7-46fb-8fcc-dd1d5db980ce),
    version(1.0),
    pointer_default(unique)
]
interface IDcomLaunchServiceStart
{
    /* Start the service that the machine's registration of the class names as its LocalService */
    HRESULT DcomLaunchStartLocalService(
        [in] handle_t BindingHandle,
        [in] const GUID *Clsid);
}
