[
    dual,
    object,
    oleautomation,
    uuid(8cfac062-a080-4c15-9a88-aa7c2af80dfc)
]
interface ITaskFolder : IDispatch
{
    [id(1), propget] HRESULT Name([out, retval] BSTR *name);
    [id(2), propget] HRESULT Path([out, retval] BSTR *path);
    [id(3)] HRESULT GetFolder([in] BSTR path, [out, retval] ITaskFolder **folder);
    [id(4)] HRESULT GetFolders([in] LONG flags, [out, retval] ITaskFolderCollection **folders);
    [id(5)] HRESULT CreateFolder([in] BSTR name, [in, optional] VARIANT sddl, [out, retval] ITaskFolder **folder);
    [id(6)] HRESULT DeleteFolder([in] BSTR name, [in] LONG flags);
    [id(7)] HRESULT GetTask([in] BSTR path, [out, retval] IRegisteredTask **task);
    [id(8)] HRESULT GetTasks([in] LONG flags, [out, retval] IRegisteredTaskCollection **tasks);
    [id(9)] HRESULT DeleteTask([in] BSTR name, [in] LONG flags);
    [id(10)] HRESULT RegisterTask([in] BSTR path, [in] BSTR xml, [in] LONG flags, [in] VARIANT user, [in] VARIANT password,
                         [in] TASK_LOGON_TYPE logonType, [in, optional] VARIANT sddl, [out, retval] IRegisteredTask **task);
    [id(11)] HRESULT RegisterTaskDefinition([in] BSTR path, [in] ITaskDefinition *definition, [in] LONG flags,
                                   [in] VARIANT user,  [in] VARIANT password,  [in] TASK_LOGON_TYPE logon,
                                   [in, optional] VARIANT sddl, [out, retval] IRegisteredTask **task);
    [id(12)] HRESULT GetSecurityDescriptor(LONG info, [out, retval] BSTR *sddl);
    [id(13)] HRESULT SetSecurityDescriptor([in] BSTR sddl, [in] LONG flags);
}

