interface IExecAction;
interface INetworkSettings;
interface IPrincipal;

[
    dual,
    object,
    oleautomation,
    uuid(2faba4c7-4da9-4013-9697-20cc3fd40f85)
]
interface ITaskService : IDispatch
{
    [id(1)] HRESULT GetFolder([in] BSTR path, [out, retval] ITaskFolder **folder );
    [id(2)] HRESULT GetRunningTasks([in] LONG flags, [out, retval] IRunningTaskCollection **tasks );
    [id(3)] HRESULT NewTask([in] DWORD flags, [out, retval] ITaskDefinition **definition );
    [id(4)] HRESULT Connect([in, optional] VARIANT server, [in, optional] VARIANT user, [in, optional] VARIANT domain, [in, optional] VARIANT password);
    [id(5), propget] HRESULT Connected([out, retval] VARIANT_BOOL *connected);
    [id(6), propget] HRESULT TargetServer([out, retval] BSTR *server);
    [id(7), propget] HRESULT ConnectedUser([out, retval] BSTR *user);
    [id(8), propget] HRESULT ConnectedDomain([out, retval] BSTR *domain);
    [id(9), propget] HRESULT HighestVersion([out, retval] DWORD *version);
}

[
    dual,
    object,
    oleautomation,
    uuid(9c86f320-dee3-4dd1-b972-a303f26b061e)
]
interface IRegisteredTask : IDispatch
{
    [id(1), propget] HRESULT Name([out, retval] BSTR *name);
    [id(2), propget] HRESULT Path([out, retval] BSTR *path);
    [id(3), propget] HRESULT State([out, retval] TASK_STATE *state);
    [id(4), propget] HRESULT Enabled([out, retval] VARIANT_BOOL *enabled);
    [id(4), propput] HRESULT Enabled(VARIANT_BOOL enabled);
    [id(5)] HRESULT Run([in] VARIANT params, [out, retval] IRunningTask **task);
    [id(6)] HRESULT RunEx([in] VARIANT params, [in] LONG flags, [in] LONG sessionID, [in] BSTR user, [out, retval] IRunningTask **task);
    [id(7)] HRESULT GetInstances([in] LONG flags, [out, retval] IRunningTaskCollection **tasks);
    [id(8), propget] HRESULT LastRunTime([out, retval] DATE *date);
    [id(9), propget] HRESULT LastTaskResult([out, retval] LONG *result);
    [id(10), propget] HRESULT NumberOfMissedRuns([out, retval] LONG *runs);
    [id(11), propget] HRESULT NextRunTime([out, retval] DATE *date);
    [id(12), propget] HRESULT Definition([out, retval] ITaskDefinition **task);
    [id(13), propget] HRESULT Xml([out, retval] BSTR *xml);
    [id(14)] HRESULT GetSecurityDescriptor([in] LONG info, [out, retval] BSTR *sddl);
    [id(15)] HRESULT SetSecurityDescriptor([in] BSTR sddl, [in] LONG flags);
    [id(16)] HRESULT Stop([in] LONG flags);
    [id(17)] HRESULT GetRunTimes([in] const LPSYSTEMTIME start, [in] const LPSYSTEMTIME end, [in, out] DWORD *count, [out] LPSYSTEMTIME *time);
}

[
    dual,
    object,
