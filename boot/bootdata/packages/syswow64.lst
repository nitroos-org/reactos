@0x600 SysWOW64/win32u.dll

# The Mesa3D OpenGL driver (i386 llvmpipe from dll/3rdparty/mesa3d/i386-llvm, else the in-tree softpipe) and its
# licence notices, so that the opengl32 above gives 32-bit programs OpenGL 4.6 (3.3 with softpipe) instead of the
# built-in 1.1. Registered in the 32-bit view by hivesft_amd64.inf.
@0x600 SysWOW64/libgallium_wgl.dll
@0x600 SysWOW64/mesa3d-licenses.txt

# Direct2D (d2d1.dll!D2D1CreateFactory, imported by the 32-bit WordCraft) and the import chain it
# needs: d3d10_1 -> d3d10core/d3d10 -> d3dcompiler_39, plus d3dcompiler_47. dwrite, xmllite and
# ole32 (d2d1 delay imports) are listed above. Loading only; no 32-bit display driver path is claimed.
@0x600 SysWOW64/d2d1.dll
@0x600 SysWOW64/d3d10_1.dll
@0x600 SysWOW64/d3d10core.dll
@0x600 SysWOW64/d3d10.dll
@0x600 SysWOW64/d3dcompiler_39.dll
@0x600 SysWOW64/d3dcompiler_47.dll

# d3d12.dll for 32-bit modules that import D3D12CreateDevice: the stub of dll/win32/d3d12 (built below export
# level 0xA00), which loads and has no adapter.
SysWOW64/d3d12.dll

# UI Automation client (uiautomationcore.dll: the 7 Uia* functions the 32-bit WordCraft imports).
# Imports shlwapi, oleaut32, ole32, oleacc, combase and user32, all listed above.
SysWOW64/uiautomationcore.dll

# Runtime dependencies of common 32-bit apps (T136): Firefox 52 imports pdh (xul.dll) and
# delay-loads msdmo; its ANGLE libGLESv2 imports d3d9; Winamp visualisers import ddraw and the
# WMA encoder imports wmvcore. Each is loaded with an import chain that is listed here too.
SysWOW64/pdh.dll
SysWOW64/msdmo.dll
@0x600 SysWOW64/d3d9.dll
SysWOW64/ddraw.dll
SysWOW64/wmvcore.dll

# Games and older media apps (T138): DirectSound, DirectInput (legacy and 8) and Direct3D 8.
# d3d8 imports d3dwine, which is only listed from export level 0x600, so d3d8 is too.
SysWOW64/dsound.dll
SysWOW64/dinput.dll
SysWOW64/dinput8.dll
@0x600 SysWOW64/d3d8.dll

# Human interface device helpers (hid.dll): imported by the 32-bit user32 winetest (raw input
# tests) and by hid_winetest. It only needs kernel32 and msvcrt, so there is no import chain to add.
SysWOW64/hid.dll

# .NET host shim (mscoree.dll). Every .NET assembly built for AnyCPU/x86 imports it by name (the _CorDllMain stub);
# the 32-bit PowerShell 7 / CoreCLR host fails to start without it ("mscoree.dll was not found"). Its imports
# (dbghelp, shell32, shlwapi, ole32, advapi32, kernel32_vista, msvcrt) are all listed above.
SysWOW64/mscoree.dll

# 32-bit .NET (CoreCLR) P/Invokes: System.Net.Security / System.Net.Primitives call sspicli.dll (TLS, NTLM),
# the PowerShell eventing assembly calls wevtapi.dll. Imports: secur32, user32, advapi32 (all listed above).
SysWOW64/sspicli.dll
SysWOW64/wevtapi.dll

# More 32-bit .NET P/Invoke targets (found by scanning the ModuleRef tables and strings of the PowerShell 7 win-x86
# assemblies). Each is reached only from a rarely used API; without the i386 copy the first call throws DllNotFoundException.
# Loading only; no functional claim beyond what each DLL implements. Every import chain is already listed above.
#   System.Net.HttpListener -> httpapi; System.Data.Odbc/OleDb/SqlClient -> odbc32, xolehlp;
#   System.DirectoryServices -> activeds, ntdsapi, netutils; System.Security.AccessControl/Principal -> authz;
#   WPF -> mscms, windowscodecsext, dxva2, evr; Windows Forms -> hhctrl, mshtml; ReachFramework -> compstui;
#   UIAutomation/WindowsBase -> loadperf; CoreCLR crash reporting -> faultrep.
SysWOW64/httpapi.dll
SysWOW64/authz.dll
SysWOW64/netutils.dll
SysWOW64/activeds.dll
SysWOW64/ntdsapi.dll
SysWOW64/odbc32.dll
SysWOW64/xolehlp.dll
SysWOW64/mscms.dll
SysWOW64/windowscodecsext.dll
SysWOW64/hhctrl.ocx
SysWOW64/mshtml.dll
# The Wine 10.0 mshtml loads its public type library (mshtml.tlb, LIBID_MSHTML 4.0) for the first object it creates. It is
# registered under System32; a 32-bit process reaches it through the file system redirection, so the i386 copy has to exist.
SysWOW64/mshtml.tlb
SysWOW64/compstui.dll
SysWOW64/loadperf.dll
SysWOW64/faultrep.dll
@0x600 SysWOW64/dxva2.dll
@0x601 SysWOW64/evr.dll

