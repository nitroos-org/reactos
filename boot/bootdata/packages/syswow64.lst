# Direct3D 11 and its import chain, so 32-bit D3D11 apps (vcamp140 x86) can
# load. Loading only; no 32-bit display driver path is claimed.
@0x600 SysWOW64/d3d11.dll
@0x600 SysWOW64/dxgi.dll
@0x600 SysWOW64/d3dwine.dll
@0x600 SysWOW64/gdi32_vista.dll
