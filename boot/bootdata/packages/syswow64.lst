# These DLLs use W32K_WIDE in the nested guest build, including their layout pins.
# Window creation still needs the win32k syscall and callback translation.
SysWOW64/user32.dll
SysWOW64/gdi32.dll
SysWOW64/imm32.dll

# GUI applications and the common-dialog/common-control dependency closure.
