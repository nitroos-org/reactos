SysWOW64/webservices.dll
# ... and activates Windows.Management.Deployment.PackageManager (registered for 32-bit in hivesft_amd64.inf).
SysWOW64/appxdeploymentclient.dll
# Windows.System.DispatcherQueue and CreateDispatcherQueueController (registered for 32-bit in hivesft_amd64.inf).
SysWOW64/coremessaging.dll
# Qt 6.8 (32-bit) activates Windows.UI.ViewManagement.UISettings for its platform theme (registered for 32-bit in hivesft_amd64.inf).
SysWOW64/windows.ui.dll
# Qt 5.15 (32-bit) creates the Network List Manager (registered for 32-bit in hivesft_amd64.inf).
SysWOW64/netprofm.dll
