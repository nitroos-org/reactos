[Version]
Signature = "$Windows NT$"

[AddReg]

; The 32-bit view of the Mesa3D OpenGL driver registration of hivesft.inf. HKLM\SOFTWARE is redirected to
; SOFTWARE\Wow6432Node for 32-bit processes and neither key is shared, so without these the opengl32 of SysWOW64
; finds no driver and gives 32-bit programs the built-in OpenGL 1.1. libgallium_wgl.dll resolves to the i386
; driver in SysWOW64 (boot/bootdata/packages/syswow64.lst), as Windows registers 32-bit ICDs.
HKLM,"SOFTWARE\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa3D","Dll",0x00000000,"libgallium_wgl.dll"
HKLM,"SOFTWARE\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa3D","Version",0x00010001,0x00000001
HKLM,"SOFTWARE\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa3D","DriverVersion",0x00010001,0x00000001
HKLM,"SOFTWARE\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa3D","Flags",0x00010001,0x00000001
HKLM,"SOFTWARE\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa3D","RequiresSSE2",0x00010001,0x00000001
HKLM,"SOFTWARE\Wow6432Node\ReactOS\OpenGL",,0x00000000,"Mesa3D"

; The 32-bit view of the PackageManager WinRT class of hivesft.inf (WindowsRuntime is redirected, not shared, as on
; Windows): the 32-bit Office Deployment Tool setup.exe activates it from SysWOW64\AppXDeploymentClient.dll.
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.Management.Deployment.PackageManager","ActivationType",0x00010001,0
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.Management.Deployment.PackageManager","DllPath",0x00020000,"%SystemRoot%\SysWOW64\AppXDeploymentClient.dll"
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.Management.Deployment.PackageManager","Threading",0x00010001,0
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.Management.Deployment.PackageManager","TrustLevel",0x00010001,1

; The 32-bit view of the UISettings WinRT class (Qt 6.8 builds its Windows platform theme from it): SysWOW64\Windows.UI.dll.
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.UI.ViewManagement.UISettings","ActivationType",0x00010001,0
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.UI.ViewManagement.UISettings","DllPath",0x00020000,"%SystemRoot%\SysWOW64\Windows.UI.dll"
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.UI.ViewManagement.UISettings","Threading",0x00010001,0
HKLM,"SOFTWARE\Wow6432Node\Microsoft\WindowsRuntime\ActivatableClassId\Windows.UI.ViewManagement.UISettings","TrustLevel",0x00010001,0

; Web browser registrations name the 64-bit Internet Explorer through %ProgramW6432%. hivesft.inf and hivecls.inf use
; %ProgramFiles%, which a 32-bit process expands to "Program Files (x86)", where this system has no iexplore.exe:
; ShellExecute of a URL or .html from a 32-bit program (an OAuth login that opens the system browser, such as KROS
; ALFA plus) failed with ERROR_PATH_NOT_FOUND. Windows ships a 32-bit iexplore.exe there; here the 64-bit one is
; started instead, and both views of every process define ProgramW6432 (userenv, dll/wow64/environment.c).
HKLM,"SOFTWARE\Classes\Applications\iexplore.exe\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" ""%1"""
HKLM,"SOFTWARE\Classes\ftp\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" ""%1"""
HKLM,"SOFTWARE\Classes\gopher\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" ""%1"""
HKLM,"SOFTWARE\Classes\http\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" ""%1"""
HKLM,"SOFTWARE\Classes\https\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" ""%1"""
HKLM,"SOFTWARE\Classes\htafile\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" %1"
HKLM,"SOFTWARE\Classes\htmlfile\shell\open\command","",0x00020000,"""%ProgramW6432%\Internet Explorer\iexplore.exe"" ""%1"""
HKLM,"SOFTWARE\Clients\StartMenuInternet\IEXPLORE.EXE\DefaultIcon","",0x00020000,"%ProgramW6432%\Internet Explorer\iexplore.exe,-7"
HKLM,"SOFTWARE\Clients\StartMenuInternet\IEXPLORE.EXE\shell\open\command","",0x00020000,"%ProgramW6432%\Internet Explorer\iexplore.exe"
