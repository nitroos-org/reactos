; VIOSTOR.INF
;
; Installation file for VirtIO block controllers (transitional PCI\VEN_1AF4&DEV_1001 and
; modern PCI\VEN_1AF4&DEV_1042), the IDs listed by the viostor driver of the virtio-win project
;
[Version]
Signature  = "$Windows NT$"
Class      = SCSIAdapter
ClassGUID  = {4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 11/19/2026,1.0

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
viostor.sys = 1

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%VirtIOMfg% = VirtIOMfg,NTx86,NTamd64

[VirtIOMfg]
%PCI\VEN_1AF4&DEV_1001.DeviceDesc% = Viostor_Inst, PCI\VEN_1AF4&DEV_1001
%PCI\VEN_1AF4&DEV_1042.DeviceDesc% = Viostor_Inst, PCI\VEN_1AF4&DEV_1042

[VirtIOMfg.NTx86]
%PCI\VEN_1AF4&DEV_1001.DeviceDesc% = Viostor_Inst, PCI\VEN_1AF4&DEV_1001
%PCI\VEN_1AF4&DEV_1042.DeviceDesc% = Viostor_Inst, PCI\VEN_1AF4&DEV_1042

[VirtIOMfg.NTamd64]
%PCI\VEN_1AF4&DEV_1001.DeviceDesc% = Viostor_Inst, PCI\VEN_1AF4&DEV_1001
%PCI\VEN_1AF4&DEV_1042.DeviceDesc% = Viostor_Inst, PCI\VEN_1AF4&DEV_1042

[ControlFlags]
ExcludeFromSelect = *

[Viostor_Inst]
CopyFiles = Viostor_CopyFiles

[Viostor_Inst.Services]
AddService = viostor, 0x00000002, Viostor_Service_Inst

[Viostor_Service_Inst]
DisplayName    = %Viostor.ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
ServiceBinary  = %12%\viostor.sys
LoadOrderGroup = SCSI Miniport
AddReg         = Viostor_AddReg

[Viostor_AddReg]
HKR, "Parameters\PnpInterface", "5", 0x00010001, 0x00000001
HKR, "Parameters", "BusType", 0x00010001, 0x00000001

[Viostor_CopyFiles]
viostor.sys,,,0x00000100

[Strings]
ReactOS = "ReactOS Project"
DiskName = "ReactOS installation media"
VirtIOMfg = "Red Hat, Inc."
PCI\VEN_1AF4&DEV_1001.DeviceDesc = "VirtIO Block Controller"
PCI\VEN_1AF4&DEV_1042.DeviceDesc = "VirtIO Block Controller"
Viostor.ServiceDesc = "VirtIO Block Storport Miniport Driver"
