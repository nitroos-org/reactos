    IDS_EMPTYLINE            "                                       %hs\n"
    IDS_MEDIADISCONNECTED    "   Media State . . . . . . . . . . . : Media disconnected\n"
    IDS_CONNECTIONDNSSUFFIX  "   Connection-specific DNS Suffix  . : %hs\n"
    IDS_DESCRIPTION          "   Description . . . . . . . . . . . : "
    IDS_PHYSICALADDRESS      "   Physical Address. . . . . . . . . : %hs\n"
    IDS_DHCPNO               "   DHCP Enabled. . . . . . . . . . . : No\n"
    IDS_DHCPYES              "   DHCP Enabled. . . . . . . . . . . : Yes\n"
    IDS_AUTOCONFIGNO         "   Autoconfiguration Enabled . . . . : No\n"
    IDS_AUTOCONFIGYES        "   Autoconfiguration Enabled . . . . : Yes\n"
    IDS_IPADDRESS            "   IPv4 Address. . . . . . . . . . . : %hs\n"
    IDS_SUBNETMASK           "   Subnet Mask . . . . . . . . . . . : %hs\n"
