;/*
; * regaclreviewmsg.mc
; * The message texts of the events of source RegAclReview (Application log). The event id is 1000 plus the exit
; * code of the report (0: nothing marked, 1: entries marked REVIEW, 2: something not read, 3: both); the text is
; * the one insertion string the tool passes.
; */

LanguageNames=(English=0x409:MSG00409)
MessageIdTypedef=DWORD

MessageId=1000
Language=English
%1
.

MessageId=1001
Language=English
%1
.

MessageId=1002
Language=English
%1
.

MessageId=1003
Language=English
%1
.
