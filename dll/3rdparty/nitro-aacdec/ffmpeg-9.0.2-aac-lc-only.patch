diff -ruN a/libavcodec/aacsbr_lc.c b/libavcodec/aacsbr_lc.c
--- a/libavcodec/aacsbr_lc.c
+++ b/libavcodec/aacsbr_lc.c
@@ -0,0 +1,91 @@
+/*
+ * AAC-LC-only replacement for aacsbr.c / aacps*.c / sbrdsp*.c (NitroOS).
+ *
+ * The SBR (spectral band replication, HE-AAC) and PS (parametric stereo, HE-AAC v2) tools are NOT
+ * compiled into this build. This file only keeps the channel-element allocation of the original
+ * ff_aac_sbr_ctx_alloc_init() (the decoder needs the ChannelElement and its predictor state) and
+ * makes every other SBR entry point report "not supported".
+ *
+ * This file is part of FFmpeg and is licensed under the GNU Lesser General Public License,
+ * version 2.1 or (at your option) any later version, like the file it replaces.
+ */
+
+#define USE_FIXED 0
+#include "aac_defines.h"
+#include "aac.h"
+#include "aac/aacdec.h"
+#include "aac/aacdec_usac.h"
+#include "aacsbr.h"
+#include "libavutil/mem.h"
+#include "libavutil/error.h"
+
+typedef struct ExtChannelElement {
+    ChannelElement ch;
+    PredictorState predictor_state[2][MAX_PREDICTORS];
+} ExtChannelElement;
+
+av_cold void ff_aac_sbr_init(void)
+{
+}
+
+av_cold int ff_aac_sbr_ctx_alloc_init(AACDecContext *ac, ChannelElement **che, int id_aac)
+{
+    ExtChannelElement *ext = av_mallocz(sizeof(*ext));
+
+    if (!ext)
+        return AVERROR(ENOMEM);
+    *che = &ext->ch;
+    ext->ch.ch[0].predictor_state = ext->predictor_state[0];
+    ext->ch.ch[1].predictor_state = ext->predictor_state[1];
+    return 0;
+}
+
+av_cold void ff_aac_sbr_ctx_close(ChannelElement *che)
+{
+}
+
+int ff_aac_sbr_decode_extension(AACDecContext *ac, ChannelElement *che,
+                                GetBitContext *gb, int crc, int cnt, int id_aac,
+                                int fl960)
+{
+    return AVERROR_PATCHWELCOME;
+}
+
+int ff_aac_sbr_config_usac(AACDecContext *ac, ChannelElement *che,
+                           AACUsacElemConfig *ue)
+{
+    return AVERROR_PATCHWELCOME;
+}
+
+int ff_aac_sbr_decode_usac_data(AACDecContext *ac, ChannelElement *che,
+                                AACUsacElemConfig *ue, GetBitContext *gb,
+                                int sbr_ch, int indep_flag)
+{
+    return AVERROR_PATCHWELCOME;
+}
+
+void ff_aac_sbr_apply(AACDecContext *ac, ChannelElement *che,
+                      int id_aac, int fl960,
+                      void /* float */ *L, void /* float */ *R)
+{
+}
+
+/* USAC (xHE-AAC, audio object type 42) is not compiled in either: it carries its own SBR and MPEG Surround
+ * (MPS212) tools. The audio-specific-config gate in aacdec.c already refuses it; these keep the link closed. */
+int ff_aac_usac_config_decode(AACDecContext *ac, AVCodecContext *avctx,
+                              GetBitContext *gb, OutputConfiguration *oc,
+                              int channel_config)
+{
+    return AVERROR_PATCHWELCOME;
+}
+
+int ff_aac_usac_reset_state(AACDecContext *ac, OutputConfiguration *oc)
+{
+    return 0;
+}
+
+int ff_aac_usac_decode_frame(AVCodecContext *avctx, AACDecContext *ac,
+                             GetBitContext *gb, int *got_frame_ptr)
+{
+    return AVERROR_PATCHWELCOME;
+}
