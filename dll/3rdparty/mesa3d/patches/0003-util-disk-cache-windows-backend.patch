+bool
+disk_cache_mmap_cache_index(void *mem_ctx, struct disk_cache *cache)
+{
+   HANDLE file = INVALID_HANDLE_VALUE;
+   HANDLE mapping = NULL;
+   bool mapped = false;
+
+   char *path = ralloc_asprintf(mem_ctx, "%s\\index", cache->path);
+   wchar_t *wpath = path ? wide_from_utf8(path) : NULL;
+   if (wpath == NULL)
+      goto path_fail;
+
+   file = CreateFileW(wpath, GENERIC_READ | GENERIC_WRITE,
+                      DISK_CACHE_WIN_SHARE, NULL, OPEN_ALWAYS,
+                      FILE_ATTRIBUTE_NORMAL, NULL);
+   if (file == INVALID_HANDLE_VALUE)
+      goto path_fail;
+
+   /* Force the index file to be the expected size. */
+   const uint64_t size = sizeof(*cache->size) + CACHE_INDEX_MAX_KEYS * CACHE_KEY_SIZE;
+   LARGE_INTEGER file_size;
+   if (!GetFileSizeEx(file, &file_size))
+      goto path_fail;
+
+   if ((uint64_t)file_size.QuadPart != size) {
+      /* The new bytes are zero.  Two processes that do this at once end with
+       * the same size, and that is all that is checked.
+       */
+      LARGE_INTEGER new_size;
+      new_size.QuadPart = size;
+      if (!SetFilePointerEx(file, new_size, NULL, FILE_BEGIN) ||
+          !SetEndOfFile(file))
+         goto path_fail;
+   }
+
+   /* We map this shared so that other processes see updates that we make.
+    *
+    * Note: We do use atomic addition to ensure that multiple processes don't
+    * scramble the cache size recorded in the index. But we don't use any
+    * locking to prevent multiple processes from updating the same entry
+    * simultaneously, as on the other platforms.
+    */
+   mapping = CreateFileMappingW(file, NULL, PAGE_READWRITE, 0, (DWORD)size, NULL);
+   if (mapping == NULL)
+      goto path_fail;
+
+   cache->index_mmap = MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE,
+                                     0, 0, size);
+   if (cache->index_mmap == NULL)
+      goto path_fail;
+
+   cache->index_mapping = mapping;
+   mapping = NULL;
+
+   cache->size = (p_atomic_uint64_t *) cache->index_mmap;
+   cache->stored_keys = cache->index_mmap + sizeof(uint64_t);
+   mapped = true;
+
+path_fail:
+   if (mapping)
+      CloseHandle(mapping);
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+   free(wpath);
+
+   return mapped;
+}
+
+void
+disk_cache_destroy_mmap(struct disk_cache *cache)
+{
+   if (cache->index_mmap)
+      UnmapViewOfFile(cache->index_mmap);
+   if (cache->index_mapping)
+      CloseHandle(cache->index_mapping);
+}
 
