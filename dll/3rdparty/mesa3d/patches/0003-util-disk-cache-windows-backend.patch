+
+static wchar_t *
+wide_from_utf8(const char *str)
+{
+   int n = MultiByteToWideChar(CP_UTF8, 0, str, -1, NULL, 0);
+   if (n <= 0)
+      return NULL;
+
+   wchar_t *wstr = malloc(n * sizeof(wchar_t));
+   if (!wstr)
+      return NULL;
+
+   if (MultiByteToWideChar(CP_UTF8, 0, str, -1, wstr, n) <= 0) {
+      free(wstr);
+      return NULL;
+   }
+   return wstr;
+}
+
+static char *
+utf8_from_wide(void *ctx, const wchar_t *wstr)
+{
+   int n = WideCharToMultiByte(CP_UTF8, 0, wstr, -1, NULL, 0, NULL, NULL);
+   if (n <= 0)
+      return NULL;
+
+   char *str = ralloc_size(ctx, n);
+   if (!str)
+      return NULL;
+
+   if (WideCharToMultiByte(CP_UTF8, 0, wstr, -1, str, n, NULL, NULL) <= 0) {
+      ralloc_free(str);
+      return NULL;
+   }
+   return str;
+}
+
+/* The value of an environment variable as UTF-8, or NULL when it is not set
+ * or empty.
+ */
+static char *
+getenv_utf8(void *ctx, const char *name)
+{
+   char *ret = NULL;
+   wchar_t *wname = wide_from_utf8(name);
+   if (!wname)
+      return NULL;
+
+   DWORD n = GetEnvironmentVariableW(wname, NULL, 0);
+   if (n > 1) {
+      wchar_t *wvalue = malloc(n * sizeof(wchar_t));
+      if (wvalue) {
+         DWORD len = GetEnvironmentVariableW(wname, wvalue, n);
+         if (len > 0 && len < n)
+            ret = utf8_from_wide(ctx, wvalue);
+         free(wvalue);
+      }
+   }
+   free(wname);
+   return ret;
+}
+
+static bool
+is_dir_sep(char c)
+{
+   return c == '/' || c == '\\';
+}
+
+static bool
+wide_path_is_dir(const wchar_t *wpath)
+{
+   DWORD attr = GetFileAttributesW(wpath);
+   return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+/* The cache holds code that llvmpipe executes, so only the user it belongs to
+ * (and the system and the administrators, as in a user profile) may write in
+ * it: the equivalent of mkdir(path, 0700) on POSIX.
+ */
+static TOKEN_USER *
+get_current_token_user(void)
+{
+   HANDLE token = NULL;
+   DWORD len = 0;
+   TOKEN_USER *user = NULL;
+
+   if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+      return NULL;
+
+   GetTokenInformation(token, TokenUser, NULL, 0, &len);
+   if (len) {
+      user = malloc(len);
+      if (user && !GetTokenInformation(token, TokenUser, user, len, &len)) {
+         free(user);
+         user = NULL;
+      }
+   }
+   CloseHandle(token);
+   return user;
+}
+
+/* The owner that new objects of this process get (the user, or the
+ * Administrators group for an elevated administrator).
+ */
+static TOKEN_OWNER *
+get_current_token_owner(void)
+{
+   HANDLE token = NULL;
+   DWORD len = 0;
+   TOKEN_OWNER *owner = NULL;
+
+   if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+      return NULL;
+
+   GetTokenInformation(token, TokenOwner, NULL, 0, &len);
+   if (len) {
+      owner = malloc(len);
+      if (owner && !GetTokenInformation(token, TokenOwner, owner, len, &len)) {
+         free(owner);
+         owner = NULL;
+      }
+   }
+   CloseHandle(token);
+   return owner;
+}
+
+/* CreateDirectoryW() with a DACL that is protected (nothing is inherited from
+ * the parent) and grants full control to the current user, the system and the
+ * administrators only.  Sets the last error as CreateDirectoryW() does.
+ */
+static bool
+create_protected_directory(const wchar_t *wpath)
+{
+   bool ok = false;
+   DWORD error = ERROR_ACCESS_DENIED;
+   TOKEN_USER *user = get_current_token_user();
+   BYTE system_sid[SECURITY_MAX_SID_SIZE];
+   BYTE admins_sid[SECURITY_MAX_SID_SIZE];
+   DWORD system_len = sizeof(system_sid), admins_len = sizeof(admins_sid);
+   ACL *acl = NULL;
+
+   if (!user ||
+       !CreateWellKnownSid(WinLocalSystemSid, NULL, system_sid, &system_len) ||
+       !CreateWellKnownSid(WinBuiltinAdministratorsSid, NULL, admins_sid, &admins_len))
+      goto done;
+
+   DWORD acl_size = sizeof(ACL) + 3 * (sizeof(ACCESS_ALLOWED_ACE) - sizeof(DWORD)) +
+                    GetLengthSid(user->User.Sid) + system_len + admins_len;
+   acl_size = (acl_size + 3) & ~3u;
+   acl = malloc(acl_size);
+   if (!acl || !InitializeAcl(acl, acl_size, ACL_REVISION))
+      goto done;
+
+   const DWORD flags = OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE;
+   if (!AddAccessAllowedAceEx(acl, ACL_REVISION, flags, FILE_ALL_ACCESS, user->User.Sid) ||
+       !AddAccessAllowedAceEx(acl, ACL_REVISION, flags, FILE_ALL_ACCESS, system_sid) ||
+       !AddAccessAllowedAceEx(acl, ACL_REVISION, flags, FILE_ALL_ACCESS, admins_sid))
+      goto done;
+
+   SECURITY_DESCRIPTOR sd;
+   if (!InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION) ||
+       !SetSecurityDescriptorDacl(&sd, TRUE, acl, FALSE) ||
+       !SetSecurityDescriptorControl(&sd, SE_DACL_PROTECTED, SE_DACL_PROTECTED))
+      goto done;
+
+   SECURITY_ATTRIBUTES sa = { sizeof(sa), &sd, FALSE };
+   ok = CreateDirectoryW(wpath, &sa);
+   error = GetLastError();
+
+done:
+   free(acl);
+   free(user);
+   SetLastError(error);
+   return ok;
+}
+
+/* True when the owner of the directory is the current user, or what new
+ * objects of this process are owned by.  A volume without security (the owner
+ * cannot be asked) cannot be protected either way and is accepted, as the
+ * default profile directories on it are.
+ */
+static bool
+dir_is_owned_by_current_user(const wchar_t *wpath)
+{
+   PSID owner = NULL;
+   PSECURITY_DESCRIPTOR sd = NULL;
+   bool ok = false;
+
+   DWORD err = GetNamedSecurityInfoW(wpath, SE_FILE_OBJECT,
+                                     OWNER_SECURITY_INFORMATION, &owner, NULL,
+                                     NULL, NULL, &sd);
+   if (err == ERROR_NOT_SUPPORTED || err == ERROR_INVALID_FUNCTION ||
+       err == ERROR_CALL_NOT_IMPLEMENTED) {
+      ok = true;
+   } else if (err == ERROR_SUCCESS && owner) {
+      TOKEN_USER *user = get_current_token_user();
+      TOKEN_OWNER *token_owner = get_current_token_owner();
+      ok = (user && EqualSid(owner, user->User.Sid)) ||
+           (token_owner && EqualSid(owner, token_owner->Owner));
+      free(user);
+      free(token_owner);
+   }
+
+   if (sd)
+      LocalFree(sd);
+   return ok;
+}
+
+/* Check if the directory exists or, if mkdir_if_needed is set, create it.
+ *
+ * Returns: 0 if path already exists as a directory or if created.
+ *         -1 in all other cases.
+ */
+static int
+find_or_mkdir_if_needed(const char *path, bool mkdir_if_needed)
+{
+   wchar_t *wpath = wide_from_utf8(path);
+   if (!wpath)
+      return -1;
+
+   int ret = -1;
+   if (wide_path_is_dir(wpath)) {
+      ret = 0;
+   } else if (mkdir_if_needed) {
+      /* Another process may create it at the same time. */
+      if (create_protected_directory(wpath) ||
+          (GetLastError() == ERROR_ALREADY_EXISTS && wide_path_is_dir(wpath)))
+         ret = 0;
+   }
+
+   free(wpath);
+   return ret;
+}
+
+/* Length of the root of a path ("C:", "\\server\share", "\\?\C:") that is
+ * not a directory that can be created.
+ */
+static size_t
+path_root_length(const char *path)
+{
+   size_t len = strlen(path);
+   size_t i = 0;
+
+   if (len >= 4 && is_dir_sep(path[0]) && is_dir_sep(path[1]) &&
+       (path[2] == '?' || path[2] == '.') && is_dir_sep(path[3]))
+      i = 4;
+
+   if (len >= i + 2 && path[i + 1] == ':')
+      return i + 2;
+
+   if (i == 0 && len >= 2 && is_dir_sep(path[0]) && is_dir_sep(path[1])) {
+      /* UNC: skip "\\server\share". */
+      unsigned seps = 0;
+      for (i = 2; i < len; i++) {
+         if (is_dir_sep(path[i]) && ++seps == 2)
+            return i;
+      }
+      return len;
+   }
+
+   return i;
+}
+
+/* Check if the directory exists or create it, including the parent
+ * directories if mkdir_with_parents_if_needed is set.
+ *
+ * Returns: 0 if path already exists as a directory or if created.
+ *         -1 in all other cases.
+ */
+static int
+find_or_create_dir(const char *path, bool mkdir_with_parents_if_needed)
+{
+   if (path[0] == '\0')
+      return -1;
+
+   char *p = strdup(path);
+   if (!p)
+      return -1;
+
+   const char *end = p + strlen(p) + 1; /* end points to the \0 terminator */
+   char *start = p + path_root_length(p);
+
+   for (char *q = start; q != end; q++) {
+      if (is_dir_sep(*q) || q == end - 1) {
+         if (q == start)
+            continue; /* Skip the separator after the root, and doubled ones. */
+
+         char sep = *q;
+         *q = '\0';
+
+         if (find_or_mkdir_if_needed(p, mkdir_with_parents_if_needed) == -1) {
+            free(p);
+            return -1;
+         }
+
+         *q = sep;
+      }
+   }
+   free(p);
+
+   return 0;
+}
+
+/* Concatenate an existing path and a new name to form a new path.  If the new
+ * path does not exist as a directory, create it if the mkdir param is set
+ * then return the resulting name of the new path (ralloc'ed off of 'ctx').
+ *
+ * Returns NULL on any error.
+ */
+static char *
+concatenate_and_mkdir(void *ctx, const char *path, const char *name,
+                      bool mkdir)
+{
+   char *new_path = ralloc_asprintf(ctx, "%s\\%s", path, name);
+
+   if (new_path && find_or_create_dir(new_path, mkdir) == 0)
+      return new_path;
+
+   return NULL;
+}
+
+static uint64_t
+filetime_to_u64(FILETIME ft)
+{
+   return ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+}
+
+static uint64_t
+account_size(uint64_t file_size)
+{
+   return (file_size + DISK_CACHE_WIN_UNIT - 1) & ~(uint64_t)(DISK_CACHE_WIN_UNIT - 1);
+}
+
+static HANDLE
+open_for_read(const wchar_t *wpath)
+{
+   return CreateFileW(wpath, GENERIC_READ, DISK_CACHE_WIN_SHARE, NULL,
+                      OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+}
+
+/* Read count bytes.  When this fails, *content_bad tells whether the file is
+ * shorter than it should be (the entry is damaged) or the read itself failed
+ * (a lock or sharing violation, an I/O error: nothing is known about the
+ * entry, so it must not be deleted).
+ */
+static bool
+read_all(HANDLE file, void *buf, size_t count, bool *content_bad)
+{
+   char *in = buf;
+   size_t done = 0;
+
+   *content_bad = false;
+   while (done < count) {
+      DWORD chunk = count - done > (1u << 24) ? (1u << 24) : (DWORD)(count - done);
+      DWORD got = 0;
+      if (!ReadFile(file, in + done, chunk, &got, NULL)) {
+         *content_bad = GetLastError() == ERROR_HANDLE_EOF;
+         return false;
+      }
+      if (got == 0) {
+         *content_bad = true;
+         return false;
+      }
+      done += got;
+   }
+   return true;
+}
+
+static bool
+write_all(HANDLE file, const void *buf, size_t count)
+{
+   const char *out = buf;
+   size_t done = 0;
+
+   while (done < count) {
+      DWORD chunk = count - done > (1u << 24) ? (1u << 24) : (DWORD)(count - done);
+      DWORD put = 0;
+      if (!WriteFile(file, out + done, chunk, &put, NULL) || put == 0)
+         return false;
+      done += put;
+   }
+   return true;
+}
+
+/* Take the exclusive lock of a temporary file without waiting.  Byte range
+ * locks are mandatory on Windows: the lock is on one byte far beyond the end
+ * of any entry, so that it excludes other writers (and tells the cleanup of
+ * stale files that a writer is alive) but never makes a read of the data
+ * fail, also after the file was renamed to its final name.
+ */
+static bool
+try_lock_file(HANDLE file)
+{
+   OVERLAPPED ov = { 0 };
+   ov.Offset = 0xFFFFFFFEu;
+   ov.OffsetHigh = 0xFFFFFFFFu;
+   return LockFileEx(file, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY,
+                     0, 1, 0, &ov);
+}
+
+/* Delete a file and remove its size from the accounting.  The size is that of
+ * the file as the caller found it.
+ */
+static bool
+delete_file_accounted(struct disk_cache *cache, const wchar_t *wpath,
+                      uint64_t file_size)
+{
+   if (!DeleteFileW(wpath))
+      return false;
+
+   p_atomic_add(&cache->size->value, -(uint64_t)account_size(file_size));
+   return true;
+}
+
+/* Create the directory that will be needed for the cache file for \key. */
+static void
+make_cache_file_directory(struct disk_cache *cache, const cache_key key)
+{
+   char buf[BLAKE3_HEX_LEN];
+   _mesa_blake3_format(buf, key);
+
+   char *dir = NULL;
+   if (asprintf(&dir, "%s\\%c%c", cache->path, buf[0], buf[1]) == -1)
+      return;
+
+   find_or_create_dir(dir, true);
+   free(dir);
+}
+
+struct lru_file {
+   wchar_t *path;
+   uint64_t atime;
+   uint64_t size;
+};
+
+static int
+lru_file_compare(const void *a, const void *b)
+{
+   const struct lru_file *fa = a, *fb = b;
+   return fa->atime < fb->atime ? -1 : fa->atime > fb->atime;
+}
+
+/* "<dir>\\<name>" as a malloc'ed wide string. */
+static wchar_t *
+join_wide_path(const wchar_t *dir, const wchar_t *name)
+{
+   size_t dir_len = wcslen(dir);
+   size_t name_len = wcslen(name);
+   wchar_t *path = malloc((dir_len + 1 + name_len + 1) * sizeof(wchar_t));
+   if (!path)
+      return NULL;
+
+   wmemcpy(path, dir, dir_len);
+   path[dir_len] = L'\\';
+   wmemcpy(path + dir_len + 1, name, name_len + 1);
+   return path;
+}
+
+static bool
+is_tmp_name(const wchar_t *name)
+{
+   size_t len = wcslen(name);
+   return len >= 4 && wcscmp(&name[len - 4], L".tmp") == 0;
+}
+
+/* Delete the oldest tenth (at least one) of the cache files of a directory
+ * "<cache>\xx" and return the size that was freed, or 0 on any error.  The
+ * age of a file is its last access time or its last write time, whichever is
+ * newer (NTFS may not update the access time).
+ */
+static uint64_t
+unlink_lru_files_from_directory(struct disk_cache *cache, const wchar_t *wdir)
+{
+   wchar_t *pattern = join_wide_path(wdir, L"*");
+   if (!pattern)
+      return 0;
+
+   WIN32_FIND_DATAW fd;
+   HANDLE find = FindFirstFileW(pattern, &fd);
+   free(pattern);
+   if (find == INVALID_HANDLE_VALUE)
+      return 0;
+
+   struct lru_file *files = NULL;
+   size_t count = 0, capacity = 0;
+
+   do {
+      if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+         continue;
+      if (is_tmp_name(fd.cFileName))
+         continue;
+
+      if (count == capacity) {
+         size_t new_capacity = capacity ? capacity * 2 : 64;
+         struct lru_file *tmp = realloc(files, new_capacity * sizeof(*files));
+         if (!tmp)
+            break;
+         files = tmp;
+         capacity = new_capacity;
+      }
+
+      wchar_t *path = join_wide_path(wdir, fd.cFileName);
+      if (!path)
+         break;
+
+      uint64_t atime = filetime_to_u64(fd.ftLastAccessTime);
+      uint64_t mtime = filetime_to_u64(fd.ftLastWriteTime);
+      files[count].path = path;
+      files[count].atime = MAX2(atime, mtime);
+      files[count].size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+      count++;
+   } while (FindNextFileW(find, &fd));
+   FindClose(find);
+
+   uint64_t freed = 0;
+   if (count) {
+      qsort(files, count, sizeof(*files), lru_file_compare);
+
+      size_t to_delete = count > 10 ? count / 10 : 1;
+      for (size_t i = 0; i < to_delete; i++) {
+         if (DeleteFileW(files[i].path))
+            freed += account_size(files[i].size);
+      }
+   }
+
+   for (size_t i = 0; i < count; i++)
+      free(files[i].path);
+   free(files);
+
+   if (freed)
+      p_atomic_add(&cache->size->value, -freed);
+
+   return freed;
+}
+
+/* Evict least recently used cache items */
+bool
+disk_cache_evict_lru_item(struct disk_cache *cache)
+{
+   /* With a reasonably-sized, full cache, (and with keys generated from a
+    * cryptographic hash), we can choose two random hex digits and reasonably
+    * expect the directory to exist with a file in it.  If it does not, take
+    * the first directory with a file in it, starting at the random one.
+    */
+   uint64_t rand64 = rand_xorshift128plus(cache->seed_xorshift128plus);
+
+   for (unsigned i = 0; i < 256; i++) {
+      char *dir_path;
+      if (asprintf(&dir_path, "%s\\%02x", cache->path,
+                   (unsigned)((rand64 + i) & 0xff)) < 0)
+         return false;
+
+      wchar_t *wdir = wide_from_utf8(dir_path);
+      free(dir_path);
+      if (!wdir)
+         return false;
+
+      uint64_t size = unlink_lru_files_from_directory(cache, wdir);
+      free(wdir);
+
+      if (size)
+         return true;
+   }
+
+   return false;
+}
+
+bool
+disk_cache_size_is_valid(struct disk_cache *cache)
+{
+   uint64_t size = p_atomic_read_relaxed(&cache->size->value);
+
+   if (size % DISK_CACHE_WIN_UNIT)
+      return false;
+
+   wchar_t *wpath = wide_from_utf8(cache->path);
+   if (!wpath)
+      return false;
+
+   ULARGE_INTEGER total;
+   if (GetDiskFreeSpaceExW(wpath, NULL, &total, NULL) && size > total.QuadPart) {
+      free(wpath);
+      return false;
+   }
+
+   free(wpath);
+   return true;
+}
+
+void
+disk_cache_recompute_size(struct disk_cache *cache)
+{
+   uint64_t total = 0;
+   FILETIME now_ft;
+   GetSystemTimeAsFileTime(&now_ft);
+   uint64_t now = filetime_to_u64(now_ft);
+
+   for (unsigned i = 0; i < 256; i++) {
+      char *dir_path;
+      if (asprintf(&dir_path, "%s\\%02x", cache->path, i) < 0)
+         continue;
+
+      wchar_t *wdir = wide_from_utf8(dir_path);
+      free(dir_path);
+      if (!wdir)
+         continue;
+
+      wchar_t *pattern = join_wide_path(wdir, L"*");
+      if (!pattern) {
+         free(wdir);
+         continue;
+      }
+
+      WIN32_FIND_DATAW fd;
+      HANDLE find = FindFirstFileW(pattern, &fd);
+      free(pattern);
+      if (find == INVALID_HANDLE_VALUE) {
+         free(wdir);
+         continue;
+      }
+
+      do {
+         if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            continue;
+
+         uint64_t file_size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+
+         if (is_tmp_name(fd.cFileName)) {
+            /* Remove the leftovers of a process that died while writing: no
+             * writer holds the lock of such a file.  FILETIME is in units of
+             * 100 ns.
+             */
+            if (now - filetime_to_u64(fd.ftLastWriteTime) >
+                (uint64_t)DISK_CACHE_STALE_TMP_AGE * 10000000) {
+               wchar_t *path = join_wide_path(wdir, fd.cFileName);
+               if (path) {
+                  HANDLE h = CreateFileW(path, GENERIC_READ | GENERIC_WRITE,
+                                         DISK_CACHE_WIN_SHARE, NULL,
+                                         OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL,
+                                         NULL);
+                  if (h != INVALID_HANDLE_VALUE) {
+                     if (try_lock_file(h))
+                        DeleteFileW(path);
+                     CloseHandle(h);
+                  }
+                  free(path);
+               }
+            }
+            continue;
+         }
+
+         total += account_size(file_size);
+      } while (FindNextFileW(find, &fd));
+
+      FindClose(find);
+      free(wdir);
+   }
+
+   p_atomic_set(&cache->size->value, total);
+}
+
+void
+disk_cache_evict_item(struct disk_cache *cache, char *filename)
+{
+   wchar_t *wpath = wide_from_utf8(filename);
+   free(filename);
+   if (!wpath)
+      return;
+
+   WIN32_FILE_ATTRIBUTE_DATA data;
+   if (GetFileAttributesExW(wpath, GetFileExInfoStandard, &data)) {
+      uint64_t file_size = ((uint64_t)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+      delete_file_accounted(cache, wpath, file_size);
+   }
+
+   free(wpath);
+}
+
+void *
+disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
+{
+   uint8_t *data = NULL;
+   uint8_t *uncompressed_data = NULL;
+   HANDLE file = INVALID_HANDLE_VALUE;
+   bool drop = false;
+   uint64_t drop_size = 0;
+
+   wchar_t *wpath = wide_from_utf8(filename);
+   if (!wpath)
+      goto done;
+
+   file = open_for_read(wpath);
+   if (file == INVALID_HANDLE_VALUE)
+      goto done;
+
+   LARGE_INTEGER file_size;
+   if (!GetFileSizeEx(file, &file_size))
+      goto done;
+
+   /* From here on the file exists: if it cannot be used, remove it, because a
+    * cache file is never overwritten.
+    */
+   drop = true;
+   drop_size = MAX2(file_size.QuadPart, 0);
+   if (file_size.QuadPart <= 0 ||
+       (uint64_t)file_size.QuadPart > DISK_CACHE_WIN_MAX_ENTRY_SIZE)
+      goto done;
+
+   data = malloc(file_size.QuadPart);
+   if (data == NULL) {
+      drop = false; /* not the fault of the file */
+      goto done;
+   }
+
+   bool content_bad;
+   if (!read_all(file, data, file_size.QuadPart, &content_bad)) {
+      /* A failed read (lock or sharing violation, I/O error) is a miss, not
+       * proof that the entry is bad.
+       */
+      if (!content_bad)
+         drop = false;
+      goto done;
+   }
+
+   bool out_of_memory = false;
+   uncompressed_data =
+      parse_and_validate_cache_item_ex(cache, data, file_size.QuadPart, size,
+                                       &out_of_memory);
+   if (uncompressed_data || out_of_memory)
+      drop = false;
