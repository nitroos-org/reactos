+/* Return a filename within the cache's directory corresponding to 'key'.
+ *
+ * Returns NULL if out of memory.
+ */
+char *
+disk_cache_get_cache_filename(struct disk_cache *cache, const cache_key key)
+{
+   char buf[BLAKE3_HEX_LEN];
+   char *filename;
+
+   if (cache->path_init_failed)
+      return NULL;
+
+   _mesa_blake3_format(buf, key);
+   if (asprintf(&filename, "%s\\%c%c\\%s", cache->path, buf[0],
+                buf[1], buf + 2) == -1)
+      return NULL;
+
+   return filename;
+}
+
+void
+disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
+                              char *filename)
+{
+   HANDLE file = INVALID_HANDLE_VALUE;
+   wchar_t *wfilename_tmp = NULL;
+   uint64_t written_account = 0;
+   struct blob cache_blob;
+   blob_init(&cache_blob);
+
+   wchar_t *wfilename = wide_from_utf8(filename);
+   if (!wfilename)
+      goto done;
+
+   /* Write to a temporary file to allow for an atomic rename to the final
+    * destination filename, (to prevent any readers from seeing a partially
+    * written file).
+    */
+   char *filename_tmp = NULL;
+   if (asprintf(&filename_tmp, "%s.tmp", filename) == -1)
+      goto done;
+   wfilename_tmp = wide_from_utf8(filename_tmp);
+   free(filename_tmp);
+   if (!wfilename_tmp)
+      goto done;
+
+   /* The file is not truncated before it is locked: it may be in use. */
+   file = CreateFileW(wfilename_tmp, GENERIC_READ | GENERIC_WRITE,
+                      DISK_CACHE_WIN_SHARE, NULL, OPEN_ALWAYS,
+                      FILE_ATTRIBUTE_NORMAL, NULL);
+
+   /* Make the two-character subdirectory within the cache as needed. */
+   if (file == INVALID_HANDLE_VALUE) {
+      if (GetLastError() != ERROR_PATH_NOT_FOUND)
+         goto done;
+
+      make_cache_file_directory(dc_job->cache, dc_job->key);
+
+      file = CreateFileW(wfilename_tmp, GENERIC_READ | GENERIC_WRITE,
+                         DISK_CACHE_WIN_SHARE, NULL, OPEN_ALWAYS,
+                         FILE_ATTRIBUTE_NORMAL, NULL);
+      if (file == INVALID_HANDLE_VALUE)
+         goto done;
+   }
+
+   /* With the temporary file open, we take an exclusive lock on it. If that
+    * fails, then another process still has the file open with the lock held.
+    * So just let that process be responsible for writing the file.
+    */
+   if (!try_lock_file(file))
+      goto done;
+
+   /* Now that we have the lock on the open temporary file, we can check to
+    * see if the destination file already exists. If so, another process won
+    * the race between when we saw that the file didn't exist and now. In this
+    * case, we don't do anything more, (to ensure the size accounting of the
+    * cache doesn't get off).
+    */
+   if (GetFileAttributesW(wfilename) != INVALID_FILE_ATTRIBUTES) {
+      /* The handle keeps the file alive; the delete completes at the close. */
+      DeleteFileW(wfilename_tmp);
+      goto done;
+   }
+
+   /* OK, we're now on the hook to write out a file that we know is not in
+    * the cache, and is also not being written out to the cache by some other
+    * process.
+    */
+   if (!create_cache_item_header_and_blob(dc_job, &cache_blob)) {
+      DeleteFileW(wfilename_tmp);
+      goto done;
+   }
+
+   /* Discard the leftovers of a writer that died. */
+   LARGE_INTEGER zero = { 0 };
+   if (!SetFilePointerEx(file, zero, NULL, FILE_BEGIN) || !SetEndOfFile(file) ||
+       !write_all(file, cache_blob.data, cache_blob.size)) {
+      DeleteFileW(wfilename_tmp);
+      goto done;
+   }
+
+   /* Rename the file into place while the lock is held.  The target does not
+    * exist, and MOVEFILE_REPLACE_EXISTING is not given, so a writer that came
+    * in between does not make the size accounting wrong.
+    */
+   if (!MoveFileExW(wfilename_tmp, wfilename, 0)) {
+      DeleteFileW(wfilename_tmp);
+      goto done;
+   }
+
+   p_atomic_add(&dc_job->cache->size->value, account_size(cache_blob.size));
+   written_account = account_size(cache_blob.size);
+
+ done:
+   /* This close finally releases the lock, (now that the final file has been
+    * renamed into place and the size has been added).
+    */
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+   free(wfilename_tmp);
+   free(wfilename);
+   blob_finish(&cache_blob);
+
+   /* The shared size drifts low when a rescan of one process overwrites what
+    * the others added meanwhile, and when a process dies between the rename
+    * and the add.  A low size never triggers an eviction, so measure the
+    * directory again after every max_size / 8 bytes this process stored.
+    */
+   if (written_account) {
+      static uint32_t stored_since_rescan;
+      uint64_t limit = MIN2(MAX2(dc_job->cache->max_size / 8, (uint64_t)64 * 1024),
+                            (uint64_t)1 << 30);
+      if (p_atomic_add_return(&stored_since_rescan, (uint32_t)written_account) >= limit) {
+         p_atomic_set(&stored_since_rescan, 0);
+         disk_cache_recompute_size(dc_job->cache);
+      }
+   }
+}
