+/* Determine path for cache based on the first defined name as follows:
+ *
+ *   %MESA_SHADER_CACHE_DIR%\mesa_shader_cache
+ *   %LOCALAPPDATA%\Mesa\shader_cache
+ *   %USERPROFILE%\AppData\Local\Mesa\shader_cache
+ *
+ * Only DISK_CACHE_MULTI_FILE is implemented on this platform: NULL is
+ * returned for the other types.
+ *
+ * If the mkdir param is set we create the directory if it doesn't already
+ * exist, if it does not exist and the param is false NULL will be returned.
+ */
+static const char *
+generate_cache_dir(void *mem_ctx, const char *cache_dir_name_custom,
+                   enum disk_cache_type cache_type, bool mkdir)
+{
+   if (cache_type != DISK_CACHE_MULTI_FILE || cache_dir_name_custom)
+      return NULL;
+
+   const char *path = getenv_utf8(mem_ctx, "MESA_SHADER_CACHE_DIR");
+   if (path)
+      return concatenate_and_mkdir(mem_ctx, path, CACHE_DIR_NAME, mkdir);
+
+   path = getenv_utf8(mem_ctx, "LOCALAPPDATA");
+   if (!path) {
+      const char *profile = getenv_utf8(mem_ctx, "USERPROFILE");
+      if (!profile)
+         return NULL;
+
+      path = concatenate_and_mkdir(mem_ctx, profile, "AppData", mkdir);
+      if (!path)
+         return NULL;
+      path = concatenate_and_mkdir(mem_ctx, path, "Local", mkdir);
+      if (!path)
+         return NULL;
+   }
+
+   path = concatenate_and_mkdir(mem_ctx, path, "Mesa", mkdir);
+   if (!path)
+      return NULL;
+
+   return concatenate_and_mkdir(mem_ctx, path, "shader_cache", mkdir);
+}
+
+const char *
+disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
+                              const char *driver_id,
+                              const char *cache_dir_name_custom,
+                              enum disk_cache_type cache_type,
+                              bool mkdir)
+{
+   const char *path = generate_cache_dir(mem_ctx, cache_dir_name_custom,
+                                         cache_type, mkdir);
+   if (!path)
+      return NULL;
+
+   /* The paths are not opened with the \\?\ prefix: with a directory so long
+    * that "\xx\<62 hex digits>.tmp" does not fit in MAX_PATH no entry could
+    * ever be stored, so do not pretend the cache works.
+    */
+   if (strlen(path) + 1 + 2 + 1 + 62 + 4 >= MAX_PATH) {
+      static uint32_t reported_long;
+      if (!p_atomic_xchg(&reported_long, true))
+         fprintf(stderr, "Cannot use %s for shader cache (path too long)"
+                         "---disabling.\n", path);
+      return NULL;
+   }
+
+   /* A cache directory that somebody else created (and so owns, and can give
+    * anybody access to) is not used: the entries are executed as code.
+    */
+   wchar_t *wpath = wide_from_utf8(path);
+   bool owned = wpath && dir_is_owned_by_current_user(wpath);
+   free(wpath);
+   if (!owned) {
+      static uint32_t reported;
+      if (!p_atomic_xchg(&reported, true))
+         fprintf(stderr, "Cannot use %s for shader cache (not owned by the "
+                         "current user)---disabling.\n", path);
+      return NULL;
+   }
+
+   return path;
+}
+
+void
+disk_cache_touch_cache_user_marker(char *path)
+{
+   char *marker_path = NULL;
+   if (asprintf(&marker_path, "%s\\marker", path) == -1)
+      return;
+
+   wchar_t *wpath = wide_from_utf8(marker_path);
+   free(marker_path);
+   if (!wpath)
+      return;
+
+   WIN32_FILE_ATTRIBUTE_DATA data;
+   FILETIME now_ft;
+   GetSystemTimeAsFileTime(&now_ft);
+
+   if (!GetFileAttributesExW(wpath, GetFileExInfoStandard, &data)) {
+      HANDLE file = CreateFileW(wpath, GENERIC_WRITE, DISK_CACHE_WIN_SHARE,
+                                NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL,
+                                NULL);
+      if (file != INVALID_HANDLE_VALUE)
+         CloseHandle(file);
+   } else if (filetime_to_u64(now_ft) - filetime_to_u64(data.ftLastWriteTime) >
+              (uint64_t)60 * 60 * 24 * 10000000 /* One day */) {
+      HANDLE file = CreateFileW(wpath, FILE_WRITE_ATTRIBUTES,
+                                DISK_CACHE_WIN_SHARE, NULL, OPEN_EXISTING,
+                                FILE_ATTRIBUTE_NORMAL, NULL);
+      if (file != INVALID_HANDLE_VALUE) {
+         SetFileTime(file, NULL, NULL, &now_ft);
+         CloseHandle(file);
+      }
+   }
+
+   free(wpath);
+}
