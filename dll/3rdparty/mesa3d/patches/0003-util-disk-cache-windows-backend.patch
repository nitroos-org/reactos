+ done:
+   free(data);
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+   if (drop && wpath) {
+      /* The handle is closed, so that the delete is not pending. */
+      mesa_logd("disk cache: removing the invalid entry %s", filename);
+      delete_file_accounted(cache, wpath, drop_size);
+   }
+   free(wpath);
+   free(filename);
+
+   return uncompressed_data;
