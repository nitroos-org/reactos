LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_INTERFACE_BANNER "In future versions of Windows, Microsoft might remove the Netsh functionality\nfor TCP/IP.\n\nMicrosoft recommends that you transition to Windows PowerShell if you currently\nuse netsh to configure and manage TCP/IP.\n\nType Get-Command -Module NetTCPIP at the Windows PowerShell prompt to view\na list of commands to manage TCP/IP.\n\nVisit https://go.microsoft.com/fwlink/?LinkId=217627 for additional information\nabout PowerShell commands for TCP/IP.\n"
    IDS_HLP_INTERFACE_SHOW "Displays information.\n"
    IDS_HLP_INTERFACE_SHOW_INTERFACE "Displays interfaces.\n"
    IDS_HLP_INTERFACE_SHOW_INTERFACE_EX "\nUsage: show interface [[name=]<string>]\n\nParameters:\n\n      Tag             Value\n      name            - The name of a specific interface.\n\nRemarks: Displays the administrative state, the connection state and the type\n         of the interfaces, or of the one named.\n"
    IDS_HLP_INTERFACE_SET "Sets configuration information.\n"
    IDS_HLP_INTERFACE_SET_INTERFACE "Sets interface parameters.\n"
    IDS_HLP_INTERFACE_SET_INTERFACE_EX "\nUsage set interface [name = ] IfName\n            [ [admin = ] ENABLED|DISABLED\n              [connect = ] CONNECTED|DISCONNECTED\n              [newname = ] NewName ]\n\n      Sets interface parameters.\n\n      IfName  - the name of the interface\n      admin   - whether the interface should be enabled\n      connect - whether to connect the interface (non-LAN only).\n      newname - new name for the interface (LAN only).\n\n      Notes:\n      - At least one option other than the name must be specified.\n      - If connect = CONNECTED is specified, then the interface\n        is automatically enabled even if the admin = DISABLED\n        option is specified.\n\nExamples:\n\n      set interface name=""Wired Ethernet Connection"" admin=DISABLED\n      set interface name=""Wired Ethernet Connection"" newname=""Connection 1""\n"
    IDS_INTERFACE_SHOW_HEADER "\nAdmin State    State          Type             Interface Name\n-------------------------------------------------------------------------\n"
    IDS_INTERFACE_SHOW_ROW "%1!-15s!%2!-15s!%3!-17s!%4!s!\n"
    IDS_INTERFACE_SHOW_ONE "\n%1!-48s!\n   Type:                 %2!-22s!\n   Administrative state: %3!-22s!\n   Connect state:        %4!s!\n"

    IDS_HLP_IP_ADD "Adds a configuration entry to a table.\n"
    IDS_HLP_IP_ADD_ADDRESS     "Adds an IP address to the specified interface.\n"
    IDS_HLP_IP_ADD_ADDRESS_EX  "\nUsage: %1!s! [name=]<string> [[addr=]IP address [mask=]IP subnet mask]\n\
       [[gateway=]IP address [gwmetric=]integer]\n\n\
Parameters:\n\n\
      name         - The name of the IP interface.\n\
      addr         - The IP address to be added for the interface.\n\
      mask         - The IP subnet mask for the specified IP address.\n\
      gateway      - The default gateway for the specified IP address.\n\
      gwmetric     - The metric to the default gateway.\n\n\
Remarks: Adds IP addresses and default gateways to an interface. If DHCP\n\
         is enabled on the interface, it will be disabled.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" 10.0.0.2  255.0.0.0\n\
       %1!s! ""Local Area Connection"" gateway=10.0.0.3 gwmetric=2\n\n\
       The first command adds a static IP address of 10.0.0.2 with a subnet\n\
       mask of 255.0.0.0 to the Local Area Connection interface. The second\n\
       command adds the IP address of 10.0.0.3 as a second default gateway\n\
       for this interface with a gateway metric of 2.\n"

    IDS_HLP_IP_ADD_DNS    "Adds a static DNS server address.\n"
    IDS_HLP_IP_ADD_DNS_EX "\nUsage: %1!s! [name=]<string> [addr=]<IP address> [[index=]<integer>]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface where DNS servers are added.\n\
      addr         - The IP address for the DNS server you are adding.\n\
      index        - Specifies the index (preference) for the specified\n\
                     DNS server address.\n\n\
Remarks: Adds a new DNS server IP address to the statically-configured list.\n\
         By default, the DNS server is added to the end of the list.  If an\n\
         index is specified, the DNS server will be placed in that position\n\
         in the list, with other servers being moved down to make room.\n\
         If DNS servers were previously obtained through DHCP, the new\n\
         address will replace the old list.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" 10.0.0.1\n\
       %1!s! ""Local Area Connection"" 10.0.0.3 index=2\n"

    IDS_HLP_IP_DELETE            "Deletes a configuration entry from a table.\n"
    IDS_HLP_IP_DELETE_ADDRESS    "Deletes an IP address or default gateway from the specified interface.\n"
    IDS_HLP_IP_DELETE_ADDRESS_EX "\nUsage: %1!s! [name=]<string> [[addr=]IP address] [[gateway=]IP address|ALL]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface.\n\
      addr         - A static IP address for the interface specified by name.\n\
      gateway      - One of the following values:\n\
                     <IP address>: A specific default gateway IP address for\n\
                                   the static IP address you are deleting.\n\
                     ALL: Deletes all default gateway IP addresses for\n\
                          the static IP address you are deleting.\n\n\
Remarks: Deletes an IP address from an interface with multiple static IP\n\
         addresses, or deletes a default gateway from a specified interface.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" addr=10.0.0.1 gateway=all\n"

    IDS_HLP_IP_DELETE_ARPCACHE    "Flushes the ARP cache for one or all interfaces.\n"
    IDS_HLP_IP_DELETE_ARPCACHE_EX "\nUsage: %1!s! [name=]<string>\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The friendly name of a specific interface. If a name\n\
                     is not specified, the ARP caches for all interfaces\n\
                     are flushed.\n\n\
Remarks: Flushes the Address Resolution Protocol (ARP) cache on a specific\n\
         interface or all interfaces.\n\n\
Examples:\n\n\
       %1!s!\n\
       %1!s! name=""Local Area Connection""\n"

    IDS_HLP_IP_DELETE_DNS    "Deletes the DNS server from the specified interface.\n"
    IDS_HLP_IP_DELETE_DNS_EX "\nUsage: %1!s! [name=]<string> [[addr=]<IP address>|ALL ]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface where DNS servers are deleted.\n\
      addr         - One of the following values:\n\
                     <IP address>: A specific IP address of a DNS server\n\
                                   you are deleting.\n\
                     ALL: Deletes all configured IP addresses for DNS. servers.\n\n\
Remarks: Deletes statically configured DNS server IP addresses for a\n\
         specific interface.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" 10.0.0.1\n\
       %1!s! ""Local Area Connection"" all\n"

    IDS_HLP_IP_SET             "Sets configuration information.\n"
    IDS_HLP_IP_SET_ADDRESS     "Sets the IP address or default gateway to the specified interface.\n"
    IDS_HLP_IP_SET_ADDRESS_EX  "\nUsage: %1!s! [name=]<string> \n\
       [[source=]dhcp | \n\
        [source=] static [addr=]IP address [mask=]IP subnet mask]\n\
       [[gateway=]<IP address>|none [gwmetric=]integer]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface.\n\
      source       - One of the following values:\n\
                     dhcp: Sets DHCP as the source for configuring IP\n\
                           addresses for the specific interface.\n\
                     static: Sets the source for configuring IP addresses\n\
                             to local static configuration.\n\
      gateway      - One of the following values:\n\
                     <IP address>: A specific default gateway for the\n\
                                   static IP address you are setting.\n\
                     none: No default gateways are set.\n\
      gwmetric     - The metric for the default gateway. This field should\n\
                     not be set if gateway is set to 'none'.\n\
      The following options are used only if source is 'static':\n\
      addr         - An IP address for the specified interface.\n\
      mask         - The subnet mask for the specified IP address.\n\n\
Remarks: Used to change the IP address configuration mode from either DHCP to\n\
         static mode or static mode to DHCP. Adds IP addresses on an\n\
         interface with static IP address or adds default gateways.\n\n\
Examples:\n\n\
       %1!s! name=""Local Area Connection"" source=dhcp\n\
       %1!s! local static 10.0.0.9 255.0.0.0 10.0.0.1 1\n"

    IDS_HLP_IP_SET_DNS         "Sets DNS server mode and addresses.\n"
    IDS_HLP_IP_SET_DNS_EX      "\nUsage: %1!s! [name=]<string> [source=]dhcp|static [addr=]<IP address>|none\n\
             [[register=]none|primary|both]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface.\n\
      source       - One of the following values:\n\
                     dhcp: Sets DHCP as the source for configuring DNS\n\
                           servers for the specific interface.\n\
                     static: Sets the source for configuring DNS servers\n\
                             to local static configuration.\n\
      addr         - One of the following values:\n\
                     <IP address>: An IP address for a DNS server.\n\
                     none: Clears the list of DNS servers.\n\
      register     - One of the following values:\n\
                     none: Disables Dynamic DNS registration.\n\
                     primary: Register under the primary DNS suffix only.\n\
                     both: Register under both the primary DNS suffix, as\n\
                           well as under the connection-specific suffix.\n\n\
Remarks: Sets DNS server configuration to either DHCP or static mode. Only\n\
         when source is 'static', is the 'addr' option also available for\n\
         configuring a static list of DNS server IP addresses for the\n\
         specified interface.\n\n\
Examples:\n\n\
       %1!s! name=""Local Area Connection"" source=dhcp\n\
       %1!s! ""Local Area Connection"" static 10.0.0.1 primary\n"

    IDS_HLP_IP_SHOW              "Displays IP information.\n"
    IDS_HLP_IP_SHOW_ADDRESSES    "Displays IP address configuration.\n"
    IDS_HLP_IP_SHOW_ADDRESSES_EX "\nUsage: %1!s! [[name=]string]\n\n\
Parameters:\n\n\
      Tag             Value\n\
      name            The name of a specific interface.\n\n\
Remarks: Displays the IP address configuration for a specific interface or interfaces.\n\n\
Examples:\n\n\
      %1!s! ""Local Area network""\n"
    IDS_HLP_IP_SHOW_CONFIG       "Displays IP address and additional information.\n"
    IDS_HLP_IP_SHOW_CONFIG_EX    "\nUsage: %1!s! [[name=]string]\n\n\
Parameters:\n\n\
      Tag             Value\n\
      name            The name of a specific interface.\n\n\
Remarks: Displays the IP address and DNS server configuration for a specific interface\nor interfaces.\n\n\
Examples:\n\n\
      %1!s! ""Local Area Network""\n"
    IDS_HLP_IP_SHOW_DNS          "Displays the DNS server addresses.\n"
    IDS_HLP_IP_SHOW_DNS_EX       "\nUsage: %1!s! [[name=]string]\n\n\
Parameters:\n\n\
      Tag             Value\n\
      name            The name of a specific interface.\n\n\
Remarks: Displays the DNS server configuration for a specific interface\nor interfaces.\n\n\
Examples:\n\n\
      %1!s! ""Local Area Network""\n"

    IDS_HLP_IP_RESET    "Resets TCP/IP and related components to a clean state.\n"
    IDS_HLP_IP_RESET_EX "\nUsage: %1!s! [name=]<string>\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of a file to which to append information\n\
                     regarding what settings were reset.\n\n\
Remarks: Resets TCP/IP and related components to a clean state.\n\n\
Examples:\n\n\
       %1!s! resetlog.txt\n"

    IDS_HLP_IPV6_SHOW "Displays IPv6 information.\n"
    IDS_HLP_IPV6_SHOW_ADDRESSES "Displays IP address parameters.\n"
    IDS_HLP_IPV6_SHOW_ADDRESSES_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays IP address parameters.\n"
    IDS_HLP_IPV6_SHOW_DESTINATIONCACHE "Displays destination cache entries.\n"
    IDS_HLP_IPV6_SHOW_DESTINATIONCACHE_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays destination cache entries.\n"
    IDS_HLP_IPV6_SHOW_DNSSERVERS "Displays DNS server addresses.\n"
    IDS_HLP_IPV6_SHOW_DNSSERVERS_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays DNS server addresses.\n"
    IDS_HLP_IPV6_SHOW_GLOBAL "Displays global configuration parameters.\n"
    IDS_HLP_IPV6_SHOW_GLOBAL_EX "\nUsage: %1!s! [[level=]normal|verbose] [[store=]active|persistent]\n\nDisplays global configuration parameters.\n"
    IDS_HLP_IPV6_SHOW_INTERFACES "Displays interface parameters.\n"
    IDS_HLP_IPV6_SHOW_INTERFACES_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays interface parameters.\n"
    IDS_HLP_IPV6_SHOW_JOINS "Displays multicast groups joined.\n"
    IDS_HLP_IPV6_SHOW_JOINS_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays multicast groups joined.\n"
    IDS_HLP_IPV6_SHOW_NEIGHBORS "Displays neighbor cache entries.\n"
    IDS_HLP_IPV6_SHOW_NEIGHBORS_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays neighbor cache entries.\n"
    IDS_HLP_IPV6_SHOW_PREFIXPOLICIES "Displays prefix policy parameters.\n"
    IDS_HLP_IPV6_SHOW_PREFIXPOLICIES_EX "\nUsage: %1!s! [[level=]normal|verbose] [[store=]active|persistent]\n\nDisplays prefix policy parameters.\n"
    IDS_HLP_IPV6_SHOW_PRIVACY "Displays the temporary address parameters.\n"
    IDS_HLP_IPV6_SHOW_PRIVACY_EX "\nUsage: %1!s! [[level=]normal|verbose] [[store=]active|persistent]\n\nDisplays the temporary address parameters.\n"
    IDS_HLP_IPV6_ADD "Adds a configuration entry to a table.\n"
    IDS_HLP_IPV6_ADD_ADDRESS "Adds a static IPv6 address to the specified interface.\n"
    IDS_HLP_IPV6_ADD_ADDRESS_EX "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>[/<integer>]\n             [[type=]unicast|anycast]\n             [[validlifetime=]<integer>|infinite]\n             [[preferredlifetime=]<integer>|infinite]\n             [[store=]active|persistent]\n             [[skipassource=]true|false]\n\nParameters:\n\n       Tag                 Value\n       interface         - The name or index of the interface.\n       address           - The IPv6 address to add, optionally followed by the\n                           length of its subnet prefix (default 64).\n       type              - unicast (the default). anycast is not supported.\n       validlifetime     - How long the address is valid: seconds, a time such\n                           as 1d2h3m4s, or infinite (the default).\n       preferredlifetime - How long the address is preferred (the default is\n                           infinite).\n       store             - active: the address goes at the next restart.\n                           persistent: the address stays (the default).\n       skipassource      - true: the address is never chosen as the source of\n                           outgoing packets unless a program binds to it.\n                           The default is false.\n\nRemarks: Adds an IPv6 address to the interface.\n\nExample:\n\n       %1!s! ""Ethernet"" 2001:db8::2\n"
    IDS_HLP_IPV6_ADD_DNSSERVERS "Adds a static DNS server address.\n"
    IDS_HLP_IPV6_ADD_DNSSERVERS_EX "\nUsage: %1!s! [name=]<string> [address=]<IPv6 address>\n             [[index=]<integer>] [[validate=]yes|no]\n\nParameters:\n\n      Tag            Value\n      name         - The name or index of the interface.\n      address      - The IPv6 address of the DNS server.\n      index        - The position of the server in the list (1 is first).\n                     By default the server is added to the end.\n      validate     - Accepted, the server is not checked.\n\nRemarks: Adds an IPv6 address to the statically configured DNS servers of the\n         interface.\n\nExample:\n\n       %1!s! ""Ethernet"" 2001:db8::53 index=1\n"
    IDS_HLP_IPV6_ADD_ROUTE "Adds a route over an interface.\n"
    IDS_HLP_IPV6_ADD_ROUTE_EX "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer> [interface=]<string>\n             [[nexthop=]<IPv6 address>] [[siteprefixlength=]<integer>]\n             [[metric=]<integer>] [[publish=]no|age|yes]\n             [[validlifetime=]<integer>|infinite]\n             [[preferredlifetime=]<integer>|infinite]\n             [[store=]active|persistent]\n\nParameters:\n\n       Tag                 Value\n       prefix            - The prefix to add a route for.\n       interface         - The name or index of the interface.\n       nexthop           - The gateway, if the prefix is not on-link.\n       siteprefixlength  - Accepted, no change.\n       metric            - The metric of the route (the default is 256).\n       publish           - no (the default), age or yes: whether router\n                           advertisements carry the route.\n       validlifetime     - How long the route is valid (the default is\n                           infinite).\n       preferredlifetime - How long the route is preferred (the default is\n                           infinite).\n       store             - active: the route goes at the next restart.\n                           persistent: the route stays (the default).\n\nRemarks: Adds a route for the prefix.\n\nExample:\n\n       %1!s! 2001:db8:1::/48 ""Ethernet"" fe80::1\n"
    IDS_HLP_IPV6_DELETE "Deletes a configuration entry from a table.\n"
    IDS_HLP_IPV6_DELETE_ADDRESS "Deletes an IPv6 address from the specified interface.\n"
    IDS_HLP_IPV6_DELETE_ADDRESS_EX "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>\n             [[store=]active|persistent]\n\nParameters:\n\n       Tag              Value\n       interface      - The name or index of the interface.\n       address        - The IPv6 address to delete.\n       store          - active: the address comes back at the next restart if\n                        it is persistent.\n                        persistent: the address is gone for good (the default).\n\nRemarks: Deletes an IPv6 address from the interface.\n\nExample:\n\n       %1!s! ""Ethernet"" 2001:db8::2\n"
    IDS_HLP_IPV6_DELETE_DNSSERVERS "Deletes the DNS server from the specified interface.\n"
    IDS_HLP_IPV6_DELETE_DNSSERVERS_EX "\nUsage: %1!s! [name=]<string> [[address=]<IPv6 address>|all] [[validate=]yes|no]\n\nParameters:\n\n      Tag            Value\n      name         - The name or index of the interface.\n      address      - The IPv6 address of the DNS server to delete, or all\n                     (the default) for every statically configured server.\n      validate     - Accepted, the servers are not checked.\n\nRemarks: Deletes statically configured IPv6 DNS servers of the interface.\n\nExamples:\n\n       %1!s! ""Ethernet"" 2001:db8::53\n       %1!s! ""Ethernet"" all\n"
    IDS_HLP_IPV6_DELETE_ROUTE "Deletes a route.\n"
    IDS_HLP_IPV6_DELETE_ROUTE_EX "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer> [interface=]<string>\n             [[nexthop=]<IPv6 address>]\n             [[store=]active|persistent]\n\nParameters:\n\n       Tag                Value\n       prefix           - The prefix of the route to delete.\n       interface        - The name or index of the interface.\n       nexthop          - The gateway of the route, if it has one. Without it\n                          the routes of the prefix over the interface go.\n       store            - active: the route comes back at the next restart if\n                          it is persistent.\n                          persistent: both stores (the default).\n\nRemarks: Deletes an IPv6 route.\n\nExample:\n\n       %1!s! 2001:db8:1::/48 ""Ethernet"" fe80::1\n"
    IDS_HLP_IPV6_SET "Sets configuration information.\n"
    IDS_HLP_IPV6_SET_ADDRESS "Sets the lifetimes of an IPv6 address of the specified interface.\n"
    IDS_HLP_IPV6_SET_ADDRESS_EX "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>\n             [[type=]unicast|anycast]\n             [[validlifetime=]<integer>|infinite]\n             [[preferredlifetime=]<integer>|infinite]\n             [[store=]active|persistent]\n\nParameters:\n\n       Tag                 Value\n       interface         - The name or index of the interface.\n       address           - The IPv6 address to change.\n       type              - unicast (the default). anycast is not supported.\n       validlifetime     - How long the address is valid (the default is\n                           infinite).\n       preferredlifetime - How long the address is preferred (the default is\n                           infinite).\n       store             - active or persistent (the default).\n\nRemarks: Changes an IPv6 address of the interface.\n\nExample:\n\n       %1!s! ""Ethernet"" 2001:db8::2 validlifetime=1d preferredlifetime=1h\n"
    IDS_HLP_IPV6_SET_GLOBAL "Modifies global configuration general parameters.\n"
    IDS_HLP_IPV6_SET_GLOBAL_EX "\nUsage: %1!s! [[randomizeidentifiers=]enabled|disabled] [[store=]persistent]\n\nParameters:\n\n     Tag                  Value\n     randomizeidentifiers - Whether interface identifiers are random (the\n                          default) or formed from the hardware address. The\n                          stack reads it when an interface starts: the change\n                          takes effect after a restart.\n     store              - persistent (the default). The other parameters of\n                          the Windows command are not supported.\n\nRemarks: Modifies global configuration general parameters.\n"
    IDS_HLP_IPV6_SET_INTERFACE "Modifies interface configuration parameters for IPv6.\n"
    IDS_HLP_IPV6_SET_INTERFACE_EX "\nUsage: %1!s! [interface=]<string> [[forwarding=]enabled|disabled]\n     [[mtu=]<integer>] [[metric=]<integer>] [[dadtransmits=]<integer>]\n     [[routerdiscovery=]enabled|disabled|dhcp] [[store=]active|persistent]\n\nParameters:\n\n   Tag                Value\n   interface        - Interface name or index.\n   forwarding       - Whether packets arriving on this interface can\n                      be forwarded to other interfaces. Only disabled is\n                      supported: the stack does not forward.\n   mtu              - The MTU of this interface, from 1280 to the natural\n                      MTU of the link.\n   metric           - Interface metric, added to route metrics for\n                      all routes over the interface. 0 is the automatic\n                      metric, the other values are 1 to 9999.\n   dadtransmits     - Number of duplicate address detection transmits,\n                      from 0 to 7.\n   routerdiscovery  - Can be enabled, disabled, or controlled by DHCP.\n   store            - active: Set only lasts until the interface starts\n                      again (and the next boot).\n                      persistent: Set is persistent (default).\n\nRemarks: Modifies interface configuration parameters. The other tags of\n         the Windows command are not supported.\n\nExample:\n\n       %1!s! ""1"" metric=2 store=active\n"
    IDS_HLP_IPV6_SET_PREFIXPOLICY "Modifies prefix policy information.\n"
    IDS_HLP_IPV6_SET_PREFIXPOLICY_EX "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer> [precedence=]<integer>\n             [label=]<integer> [[store=]active|persistent]\n\nParameters:\n\n       Tag              Value\n       prefix         - Prefix of the policy to change.\n       precedence     - Precedence value for ordering (0 to 100000).\n       label          - Label value for matching (0 to 100000).\n       store          - One of the following values:\n                        active: Change only lasts until next boot.\n                        persistent: Change is persistent (default).\n\nRemarks: Modifies a source and destination address selection policy\n         for a given prefix.\n\nExample:\n\n       %1!s! ::/96 3 4\n"
    IDS_HLP_IPV6_ADD_PREFIXPOLICY "Adds a prefix policy entry.\n"
    IDS_HLP_IPV6_ADD_PREFIXPOLICY_EX "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer>\n             [precedence=]<integer> [label=]<integer>\n             [[store=]active|persistent]\n\nParameters:\n\n       Tag              Value\n       prefix         - Prefix for which to add a policy.\n       precedence     - Precedence value in the policy table, used for\n                        sorting destination addresses (0 to 100000).\n       label          - Label value that allows for policies that prefer a\n                        particular source address prefix for use with a\n                        destination address prefix (0 to 100000).\n       store          - One of the following values:\n                        active: Change only lasts until next boot.\n                        persistent: Change is persistent (default).\n\nRemarks: Adds a source and destination address selection policy for\n         a given prefix. The table holds at most 64 entries.\n\nExample:\n\n       %1!s! ::/96 3 4\n"
    IDS_HLP_IPV6_DELETE_PREFIXPOLICY "Deletes a prefix policy entry.\n"
    IDS_HLP_IPV6_DELETE_PREFIXPOLICY_EX "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer>\n             [[store=]active|persistent]\n\nParameters:\n\n       Tag              Value\n       prefix         - Prefix of the policy to delete.\n       store          - One of the following values:\n                        active: Deletion only lasts until next boot.\n                        persistent: Deletion is persistent (default).\n\nRemarks: Deletes the source and destination address selection policy\n         for a given prefix. The last entry of the table cannot be deleted.\n\nExample:\n\n       %1!s! ::/96\n"
    IDS_HLP_IPV6_SET_PRIVACY "Modifies privacy configuration parameters.\n"
    IDS_HLP_IPV6_SET_PRIVACY_EX "\nUsage: %1!s! [[state=]enabled|disabled] [[maxdadattempts=]<integer>]\n             [[maxvalidlifetime=]<integer>]\n             [[maxpreferredlifetime=]<integer>]\n             [[regeneratetime=]<integer>]\n             [[maxrandomtime=]<integer>]\n             [[store=]persistent]\n\nParameters:\n\n       Tag                    Value\n       state                - Whether temporary addresses are enabled.\n       maxdadattempts       - Duplicate address detection attempts (0 to 10).\n                              The default value is 3.\n       maxvalidlifetime     - Maximum lifetime over which a temporary\n                              address is valid.  The default value is 7d\n                              (seven days).\n       maxpreferredlifetime - Maximum lifetime over which a temporary\n                              address is preferred.  The default value is 1d\n                              (one day).\n       regeneratetime       - Time prior to deprecating a temporary\n                              address when a new address is generated.\n                              The default value is 5s (five seconds).\n       maxrandomtime        - Upper bound to use when computing a random\n                              delay at startup time.  The default value is\n                              10m (ten minutes).\n       store                - persistent (the default). The stack reads the\n                              values when it starts: the change takes\n                              effect after a restart.\n\nRemarks: Modifies parameters related to temporary address generation.\n         Time values can be expressed in days, hours, minutes, and\n         seconds; e.g. 1d2h3m4s. A temporary address is valid at least as\n         long as it is preferred, RegenerateTime is shorter than\n         MaxPreferredLifetime, and MaxRandomTime is at most 2/5 of\n         MaxPreferredLifetime and shorter than MaxPreferredLifetime minus\n         RegenerateTime.\n"
    IDS_HLP_IPV6_SHOW_INTERFACE "Displays the parameters of an interface.\n"
    IDS_HLP_IPV6_SHOW_INTERFACE_EX "\nUsage: %1!s! [[interface=]<string>]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n\nRemarks: Displays the parameters of the interface, or of every interface.\n"
    IDS_HLP_IP_SET_INTERFACE "Modifies interface configuration parameters for IPv4.\n"
    IDS_HLP_IP_SET_INTERFACE_EX "\nUsage: %1!s! [interface=]<string> [[forwarding=]enabled|disabled]\n     [[mtu=]<integer>] [[metric=]<integer>]\n     [[routerdiscovery=]dhcp] [[store=]active|persistent]\n\nParameters:\n\n   Tag                Value\n   interface        - Interface name or index.\n   forwarding       - Whether packets arriving on this interface can\n                      be forwarded to other interfaces. Only disabled is\n                      supported: the stack does not forward.\n   mtu              - The MTU of this interface, from 576 to the natural\n                      MTU of the link.\n   metric           - Interface metric, added to route metrics for\n                      all routes over the interface. 0 is the automatic\n                      metric, the other values are 1 to 9999.\n   routerdiscovery  - dhcp is the only value for IPv4.\n   store            - active: Set only lasts until the interface starts\n                      again (and the next boot).\n                      persistent: Set is persistent (default).\n\nRemarks: Modifies interface configuration parameters. The other tags of\n         the Windows command are not supported.\n\nExample:\n\n       %1!s! ""1"" metric=2 store=active\n"
    IDS_HLP_IP_SHOW_INTERFACE "Displays the parameters of an interface.\n"
    IDS_HLP_IP_SHOW_INTERFACE_EX "\nUsage: %1!s! [[interface=]<string>]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n\nRemarks: Displays the parameters of the interface, or of every interface.\n"
    IDS_HLP_IPV6_SHOW_ROUTE "Displays route table entries.\n"
    IDS_HLP_IPV6_SHOW_ROUTE_EX "\nUsage: %1!s! [[interface=]string] [[level=]normal|verbose] [[store=]active|persistent]\n\nParameters:\n\n      Tag             Value\n      interface       - The name or index of a specific interface.\n      level           - Level of detail (accepted, no change).\n      store           - Store (accepted, no change).\n\nDisplays route table entries.\n"

    IDS_HLP_WINSOCK_RESET "Resets the Winsock Catalog to a clean state.\n"
    IDS_HLP_WINSOCK_RESET_EX "\nUsage: %1!s!\n\n\
Remarks: Resets the Winsock Catalog to a clean state.\n"
    IDS_HLP_WINSOCK_SHOW  "Displays information.\n"
    IDS_HLP_WINSOCK_SHOW_CATALOG "Displays contents of Winsock Catalog.\n"
    IDS_HLP_WINSOCK_SHOW_CATALOG_EX "\nUsage: %1!s! [[type=]full]\n\n\
Parameters:\n\n\
    \n"

    IDS_IP_HEADER        "\nConfiguration for interface ""%1!s!""\n"
    IDS_DHCP_ON          "    DHCP enabled:                         Yes\n"
    IDS_DHCP_OFF         "    DHCP enabled:                         No\n"
    IDS_NOIPADDRESS      "    IP Address:                           None\n"
    IDS_IPADDRESS        "    IP Address:                           %1!s!\n"
    IDS_IPADDRESSES      "    IP Addresses:                         %1!s!\n"
    IDS_NOSUBNETMASK     "    Subnet Mask:                          None\n"
    IDS_SUBNETMASK       "    Subnet Mask:                          %1!s!\n"
    IDS_SUBNETPREFIX     "    Subnet Prefix:                        %1!s! (mask %2!s!)\n"
    IDS_SUBNETMASKS      "    Subnet Masks:                         %1!s!\n"
    IDS_DEFAULTGATEWAY   "    Default Gateway:                      %1!s!\n"
    IDS_GATEWAYMETRIC    "    Gateway Metric:                       %1!s!\n"
    IDS_INTERFACEMETRIC  "    InterfaceMetric:                      %1!s!\n"
    IDS_STATICNAMESERVER "    Statically configured DNS Servers:    %1!s!\n"
    IDS_DHCPNAMESERVER   "    DNS servers configured through DHCP:  %1!s!\n"
    IDS_NOSTATICNAMESERVER "    Statically configured DNS Servers:    None\n"
    IDS_NODHCPNAMESERVER "    DNS servers configured through DHCP:  None\n"
    IDS_EMPTYLINE        "                                          %1!s!\n"

    IDS_DUMP_NEWLINE     "\n"
    IDS_DUMP_HEADERLINE  "# ----------------------------------\n"

    IDS_DUMP_IP_HEADER    "# Interface IP Configuration\n"
    IDS_DUMP_IP_INTERFACE "# Interface IP Configuration for ""%1!s!""\n"
    IDS_DUMP_IP_FOOTER    "# End of Interface IP Configuration\n"

    IDS_ERROR_INVALID_INTERFACE  "\nInvalid interface %1!s! specified.\n"
    IDS_ERROR_MISSING_PARAMETERS "One or more essential parameters not specified\n"
    IDS_ERROR_NO_SUCH_INTERFACE "An interface with this name is not registered with the router.\n"
    IDS_ERROR_BAD_VALUE "\n%1!s! is not an acceptable value for %2!s!.\n"
    IDS_ERROR_ALREADY_DHCP "\nDhcp is already enabled on this interface.\n"
    IDS_ERROR_GET_PROPERTIES "\nError obtaining configuration for interface %1!s!.\n"

