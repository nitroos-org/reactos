LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_HLP_ADD "Adds a configuration entry to a table.\n"
    IDS_HLP_DELETE "Deletes a configuration entry from a table.\n"
    IDS_HLP_SET "Sets configuration information.\n"
    IDS_HLP_SHOW "Displays information.\n"
    IDS_HLP_RESET "Resets portproxy configuration state.\n"
    IDS_HLP_RESET_EX "\nUsage: %1!s!\n\nRemarks: Resets portproxy configuration state.\n\n"
    IDS_HLP_ADD_V4TOV4 "Adds an entry to listen on for IPv4 and proxy connect to via IPv4.\n"
    IDS_HLP_ADD_V4TOV4_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n             [connectaddress=]<IPv4 address>|<hostname> \n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv4 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv4 port on which to listen.\n       connectaddress - IPv4 address to which to connect.\n       connectport    - IPv4 port to which to connect.\n       listenaddress  - IPv4 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Adds an entry to listen on for IPv4 and proxy connect to via IPv4.\n\n"
    IDS_HLP_ADD_V4TOV6 "Adds an entry to listen on for IPv4 and proxy connect to via IPv6.\n"
    IDS_HLP_ADD_V4TOV6_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[connectaddress=]<IPv6 address>|<hostname>]\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv4 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv4 port on which to listen.\n       connectaddress - IPv6 address to which to connect.\n       connectport    - IPv6 port to which to connect.\n       listenaddress  - IPv4 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Adds an entry to listen on for IPv4 and proxy connect to via IPv6.\n\n"
    IDS_HLP_ADD_V6TOV4 "Adds an entry to listen on for IPv6 and proxy connect to via IPv4.\n"
    IDS_HLP_ADD_V6TOV4_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[connectaddress=]<IPv4 address>|<hostname>]\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv6 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv6 port on which to listen.\n       connectaddress - IPv4 address to which to connect.\n       connectport    - IPv4 port to which to connect.\n       listenaddress  - IPv6 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Adds an entry to listen on for IPv6 and proxy connect to via IPv4.\n\n"
    IDS_HLP_ADD_V6TOV6 "Adds an entry to listen on for IPv6 and proxy connect to via IPv6.\n"
    IDS_HLP_ADD_V6TOV6_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n             [connectaddress=]<IPv6 address>|<hostname>\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv6 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv6 port on which to listen.\n       connectaddress - IPv6 address to which to connect.\n       connectport    - IPv6 port to which to connect.\n       listenaddress  - IPv6 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Adds an entry to listen on for IPv6 and proxy connect to via IPv6.\n\n"
    IDS_HLP_DELETE_V4TOV4 "Deletes an entry to listen on for IPv4 and proxy connect to via IPv4.\n"
    IDS_HLP_DELETE_V4TOV4_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[listenaddress=]<IPv4 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv4 port on which to listen.\n       listenaddress  - IPv4 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Deletes an entry to listen on for IPv4 and proxy connect to via IPv4.\n\n"
    IDS_HLP_DELETE_V4TOV6 "Deletes an entry to listen on for IPv4 and proxy connect to via IPv6.\n"
    IDS_HLP_DELETE_V4TOV6_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[listenaddress=]<IPv4 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv4 port on which to listen.\n       listenaddress  - IPv4 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Deletes an entry to listen on for IPv4 and proxy connect to via IPv6.\n\n"
    IDS_HLP_DELETE_V6TOV4 "Deletes an entry to listen on for IPv6 and proxy connect to via IPv4.\n"
    IDS_HLP_DELETE_V6TOV4_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[listenaddress=]<IPv6 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv6 port on which to listen.\n       listenaddress  - IPv6 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Deletes an entry to listen on for IPv6 and proxy connect to via IPv4.\n\n"
    IDS_HLP_DELETE_V6TOV6 "Deletes an entry to listen on for IPv6 and proxy connect to via IPv6.\n"
    IDS_HLP_DELETE_V6TOV6_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[listenaddress=]<IPv6 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv6 port on which to listen.\n       listenaddress  - IPv6 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Deletes an entry to listen on for IPv6 and proxy connect to via IPv6.\n\n"
    IDS_HLP_SET_V4TOV4 "Updates an entry to listen on for IPv4 and proxy connect to via IPv4.\n"
    IDS_HLP_SET_V4TOV4_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n             [connectaddress=]<IPv4 address>|<hostname>\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv4 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv4 port on which to listen.\n       connectaddress - IPv4 address to which to connect.\n       connectport    - IPv4 port to which to connect.\n       listenaddress  - IPv4 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Updates an entry to listen on for IPv4 and proxy connect to via IPv4.\n\n"
    IDS_HLP_SET_V4TOV6 "Updates an entry to listen on for IPv4 and proxy connect to via IPv6.\n"
    IDS_HLP_SET_V4TOV6_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[connectaddress=]<IPv6 address>|<hostname>]\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv4 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv4 port on which to listen.\n       connectaddress - IPv6 address to which to connect.\n       connectport    - IPv6 port to which to connect.\n       listenaddress  - IPv4 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Updates an entry to listen on for IPv4 and proxy connect to via IPv6.\n\n"
    IDS_HLP_SET_V6TOV4 "Updates an entry to listen on for IPv6 and proxy connect to via IPv4.\n"
    IDS_HLP_SET_V6TOV4_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n            [[connectaddress=]<IPv4 address>|<hostname>]\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv6 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv6 port on which to listen.\n       connectaddress - IPv4 address to which to connect.\n       connectport    - IPv4 port to which to connect.\n       listenaddress  - IPv6 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Updates an entry to listen on for IPv6 and proxy connect to via IPv4.\n\n"
    IDS_HLP_SET_V6TOV6 "Updates an entry to listen on for IPv6 and proxy connect to via IPv6.\n"
    IDS_HLP_SET_V6TOV6_EX "\nUsage: %1!s! [listenport=]<integer>|<servicename>\n             [connectaddress=]<IPv6 address>|<hostname>\n            [[connectport=]<integer>|<servicename>]\n            [[listenaddress=]<IPv6 address>|<hostname>]\n            [[protocol=]tcp]\n\nParameters:\n\n       Tag              Value\n       listenport     - IPv6 port on which to listen.\n       connectaddress - IPv6 address to which to connect.\n       connectport    - IPv6 port to which to connect.\n       listenaddress  - IPv6 address on which to listen.\n       protocol       - Protocol to use.  Currently only TCP is supported.\n\nRemarks: Updates an entry to listen on for IPv6 and proxy connect to via IPv6.\n\n"
    IDS_HLP_SHOW_ALL "Shows all port proxy parameters.\n"
    IDS_HLP_SHOW_ALL_EX "\nUsage: %1!s!\n\nRemarks: Shows all port proxy parameters.\n\n"
    IDS_HLP_SHOW_V4TOV4 "Shows parameters for proxying IPv4 connections to another IPv4 port.\n"
    IDS_HLP_SHOW_V4TOV4_EX "\nUsage: %1!s!\n\nRemarks: Shows parameters for proxying IPv4 connections to another IPv4 port.\n\n"
    IDS_HLP_SHOW_V4TOV6 "Shows parameters for proxying IPv4 connections to IPv6.\n"
    IDS_HLP_SHOW_V4TOV6_EX "\nUsage: %1!s!\n\nRemarks: Shows parameters for proxying IPv4 connections to IPv6.\n\n"
    IDS_HLP_SHOW_V6TOV4 "Shows parameters for proxying IPv6 connections to IPv4.\n"
    IDS_HLP_SHOW_V6TOV4_EX "\nUsage: %1!s!\n\nRemarks: Shows parameters for proxying IPv6 connections to IPv4.\n\n"
    IDS_HLP_SHOW_V6TOV6 "Shows parameters for proxying IPv6 connections to another IPv6 port.\n"
    IDS_HLP_SHOW_V6TOV6_EX "\nUsage: %1!s!\n\nRemarks: Shows parameters for proxying IPv6 connections to another IPv6 port.\n\n"
    IDS_SHOW_HDR_V4TOV4 "Listen on ipv4:             Connect to ipv4:\n\n"
    IDS_SHOW_HDR_V4TOV6 "Listen on ipv4:             Connect to ipv6:\n\n"
    IDS_SHOW_HDR_V6TOV4 "Listen on ipv6:             Connect to ipv4:\n\n"
    IDS_SHOW_HDR_V6TOV6 "Listen on ipv6:             Connect to ipv6:\n\n"
    IDS_SHOW_COLS_V4 "Address         Port        Address         Port\n"
    IDS_SHOW_UNDER_V4 "--------------- ----------  --------------- ----------\n"
    IDS_SHOW_COLS_V6 "Address         Port        Address         Port\n"
    IDS_SHOW_UNDER_V6 "--------------- ----------  --------------- ----------\n"
    IDS_DUMP_HEADER "\n#========================\n# Port Proxy configuration\n#========================\n"
    IDS_DUMP_FOOTER "\n# End of Port Proxy configuration\n\n"
END
