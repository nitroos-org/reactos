#include <windef.h>
#include <winver.h>

/* The same file version as the .NET Framework 4.0 runtime directory (v4.0.30319). Every released
 * .NET Framework 4.x (4.5 ... 4.8) installs a wminet_utils.dll with a higher version, so the
 * Framework setup replaces this file. */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,0,30319,0
PRODUCTVERSION 4,0,30319,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ReactOS Project\0"
            VALUE "FileDescription", "WMI .NET helper library (ReactOS)\0"
            VALUE "FileVersion", "4.0.30319.0\0"
            VALUE "InternalName", "wminet_utils.dll\0"
            VALUE "LegalCopyright", "Copyright (C) ReactOS Project\0"
            VALUE "OriginalFilename", "wminet_utils.dll\0"
            VALUE "ProductName", "ReactOS Operating System\0"
            VALUE "ProductVersion", "4.0.30319.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
