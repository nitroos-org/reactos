[uuid(5ec0ac10-4321-1234-0000-000000000011), version(1.0)]
interface prim_handle
{
    int prim_val([in] handle_t h, [in] int a, [in] int b);
    int prim_ptr([in] handle_t h, [in] int a, [in] int b);
}
