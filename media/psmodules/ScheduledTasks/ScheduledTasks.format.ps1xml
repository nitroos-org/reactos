<?xml version="1.0" encoding="utf-8"?>
<!-- Default views of the ScheduledTasks objects of ReactOS-Nitro: the task table (TaskPath 46, TaskName 33, State 10) and the
     Format-List orders measured on Windows 10. -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>ScheduledTaskTableView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_ScheduledTask</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#Root/Microsoft/Windows/TaskScheduler/MSFT_ScheduledTask</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Width>46</Width></TableColumnHeader>
          <TableColumnHeader><Width>33</Width></TableColumnHeader>
          <TableColumnHeader><Width>10</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>TaskPath</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TaskName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>ScheduledTaskListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_ScheduledTask</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#Root/Microsoft/Windows/TaskScheduler/MSFT_ScheduledTask</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Actions</PropertyName></ListItem>
              <ListItem><PropertyName>Author</PropertyName></ListItem>
              <ListItem><PropertyName>Date</PropertyName></ListItem>
              <ListItem><PropertyName>Description</PropertyName></ListItem>
              <ListItem><PropertyName>Documentation</PropertyName></ListItem>
              <ListItem><PropertyName>Principal</PropertyName></ListItem>
              <ListItem><PropertyName>SecurityDescriptor</PropertyName></ListItem>
              <ListItem><PropertyName>Settings</PropertyName></ListItem>
              <ListItem><PropertyName>Source</PropertyName></ListItem>
              <ListItem><PropertyName>State</PropertyName></ListItem>
              <ListItem><PropertyName>TaskName</PropertyName></ListItem>
              <ListItem><PropertyName>TaskPath</PropertyName></ListItem>
              <ListItem><PropertyName>Triggers</PropertyName></ListItem>
              <ListItem><PropertyName>URI</PropertyName></ListItem>
              <ListItem><PropertyName>Version</PropertyName></ListItem>
              <ListItem><PropertyName>PSComputerName</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>TaskPrincipalListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_TaskPrincipal2</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_TaskPrincipal</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>DisplayName</PropertyName></ListItem>
              <ListItem><PropertyName>GroupId</PropertyName></ListItem>
              <ListItem><PropertyName>Id</PropertyName></ListItem>
              <ListItem><PropertyName>LogonType</PropertyName></ListItem>
              <ListItem><PropertyName>RunLevel</PropertyName></ListItem>
              <ListItem><PropertyName>UserId</PropertyName></ListItem>
              <ListItem><PropertyName>ProcessTokenSidType</PropertyName></ListItem>
              <ListItem><PropertyName>RequiredPrivilege</PropertyName></ListItem>
              <ListItem><PropertyName>PSComputerName</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>TaskSettingsListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_TaskSettings3</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_TaskSettings2</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_TaskSettings</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>AllowDemandStart</PropertyName></ListItem>
              <ListItem><PropertyName>AllowHardTerminate</PropertyName></ListItem>
              <ListItem><PropertyName>Compatibility</PropertyName></ListItem>
              <ListItem><PropertyName>DeleteExpiredTaskAfter</PropertyName></ListItem>
              <ListItem><PropertyName>DisallowStartIfOnBatteries</PropertyName></ListItem>
              <ListItem><PropertyName>Enabled</PropertyName></ListItem>
              <ListItem><PropertyName>ExecutionTimeLimit</PropertyName></ListItem>
              <ListItem><PropertyName>Hidden</PropertyName></ListItem>
              <ListItem><PropertyName>IdleSettings</PropertyName></ListItem>
              <ListItem><PropertyName>MultipleInstances</PropertyName></ListItem>
              <ListItem><PropertyName>NetworkSettings</PropertyName></ListItem>
              <ListItem><PropertyName>Priority</PropertyName></ListItem>
              <ListItem><PropertyName>RestartCount</PropertyName></ListItem>
              <ListItem><PropertyName>RestartInterval</PropertyName></ListItem>
              <ListItem><PropertyName>RunOnlyIfIdle</PropertyName></ListItem>
              <ListItem><PropertyName>RunOnlyIfNetworkAvailable</PropertyName></ListItem>
              <ListItem><PropertyName>StartWhenAvailable</PropertyName></ListItem>
              <ListItem><PropertyName>StopIfGoingOnBatteries</PropertyName></ListItem>
              <ListItem><PropertyName>WakeToRun</PropertyName></ListItem>
              <ListItem><PropertyName>DisallowStartOnRemoteAppSession</PropertyName></ListItem>
              <ListItem><PropertyName>UseUnifiedSchedulingEngine</PropertyName></ListItem>
              <ListItem><PropertyName>MaintenanceSettings</PropertyName></ListItem>
              <ListItem><PropertyName>volatile</PropertyName></ListItem>
              <ListItem><PropertyName>PSComputerName</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
