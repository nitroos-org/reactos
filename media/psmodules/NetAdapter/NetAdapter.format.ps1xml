<?xml version="1.0" encoding="utf-8"?>
<!-- Default views of the NetAdapter objects of ReactOS-Nitro: column names, widths and alignment as measured on Windows 10. -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Default</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#ROOT/StandardCimv2/MSFT_NetAdapter</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_NetAdapter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>25</Width></TableColumnHeader>
          <TableColumnHeader><Label>InterfaceDescription</Label><Width>39</Width></TableColumnHeader>
          <TableColumnHeader><Label>ifIndex</Label><Width>7</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>MacAddress</Label><Width>17</Width></TableColumnHeader>
          <TableColumnHeader><Label>LinkSpeed</Label><Width>14</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InterfaceDescription</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InterfaceIndex</PropertyName><Alignment>Right</Alignment></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MacAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LinkSpeed</PropertyName><Alignment>Right</Alignment></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MSFT_NetAdapter_Listview</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#ROOT/StandardCimv2/MSFT_NetAdapter</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_NetAdapter</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>InterfaceDescription</PropertyName></ListItem>
              <ListItem><PropertyName>InterfaceIndex</PropertyName></ListItem>
              <ListItem><PropertyName>MacAddress</PropertyName></ListItem>
              <ListItem><PropertyName>MediaType</PropertyName></ListItem>
              <ListItem><PropertyName>PhysicalMediaType</PropertyName></ListItem>
              <ListItem><Label>InterfaceOperationalStatus</Label><PropertyName>ifOperStatus</PropertyName></ListItem>
              <ListItem><PropertyName>AdminStatus</PropertyName></ListItem>
              <ListItem>
                <ItemSelectionCondition><ScriptBlock>$_.TransmitLinkSpeed -lt 1000000000</ScriptBlock></ItemSelectionCondition>
                <Label>LinkSpeed(Mbps)</Label>
                <ScriptBlock>[math]::Round($_.TransmitLinkSpeed / 1000000, 2)</ScriptBlock>
              </ListItem>
              <ListItem>
                <ItemSelectionCondition><ScriptBlock>$_.TransmitLinkSpeed -ge 1000000000</ScriptBlock></ItemSelectionCondition>
                <Label>LinkSpeed(Gbps)</Label>
                <ScriptBlock>[math]::Round($_.TransmitLinkSpeed / 1000000000, 2)</ScriptBlock>
              </ListItem>
              <ListItem><PropertyName>MediaConnectionState</PropertyName></ListItem>
              <ListItem><PropertyName>ConnectorPresent</PropertyName></ListItem>
              <ListItem><PropertyName>VlanID</PropertyName></ListItem>
              <ListItem><PropertyName>DriverInformation</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Names</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#ROOT/StandardCimv2/MSFT_NetAdapter</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_NetAdapter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>25</Width></TableColumnHeader>
          <TableColumnHeader><Label>ifDesc</Label><Width>35</Width></TableColumnHeader>
          <TableColumnHeader><Label>ifIndex</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>NetLuid</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>DeviceID</Label><Width>33</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ifDesc</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ifIndex</PropertyName><FormatString>{0,7}</FormatString></TableColumnItem>
              <TableColumnItem><PropertyName>NetLuid</PropertyName><FormatString>0x{0:X}</FormatString></TableColumnItem>
              <TableColumnItem><PropertyName>DeviceID</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Driver</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#ROOT/StandardCimv2/MSFT_NetAdapter</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_NetAdapter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>25</Width></TableColumnHeader>
          <TableColumnHeader><Label>InterfaceDescription</Label><Width>40</Width></TableColumnHeader>
          <TableColumnHeader><Label>DriverFileName</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>DriverDate</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>DriverVersion</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>NdisVersion</Label><Width>11</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InterfaceDescription</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DriverFileName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DriverDate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DriverVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>NdisVersion</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MSFT_NetAsapterStatistics_TableView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#ROOT/StandardCimv2/MSFT_NetAdapterStatisticsSettingData</TypeName>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#MSFT_NetAdapterStatisticsSettingData</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>ReceivedBytes</Label><Width>15</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ReceivedUnicastPackets</Label><Width>22</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>SentBytes</Label><Width>15</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>SentUnicastPackets</Label><Width>18</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ReceivedBytes</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ReceivedUnicastPackets</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SentBytes</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SentUnicastPackets</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
