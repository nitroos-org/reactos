        <TableHeaders>
          <TableColumnHeader><Label>InterfaceAlias</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Interface&#10;Index</Label><Width>9</Width><Alignment>Left</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Address&#10;Family</Label><Width>7</Width><Alignment>Left</Alignment></TableColumnHeader>
