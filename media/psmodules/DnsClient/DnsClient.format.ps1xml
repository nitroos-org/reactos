              <ListItem><PropertyName>InterfaceIndex</PropertyName></ListItem>
              <ListItem><Label>AddressFamily</Label><ScriptBlock>switch ([int]$_.AddressFamily) { 2 { 'IPv4' } 23 { 'IPv6' } default { $_.AddressFamily } }</ScriptBlock></ListItem>
              <ListItem><PropertyName>ServerAddresses</PropertyName></ListItem>
            </ListItems>
