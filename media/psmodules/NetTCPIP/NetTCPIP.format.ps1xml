      <ListItem><PropertyName>State</PropertyName></ListItem>
      <ListItem><PropertyName>RouteMetric</PropertyName></ListItem>
      <ListItem><PropertyName>InterfaceMetric</PropertyName></ListItem>
      <ListItem><PropertyName>Protocol</PropertyName></ListItem>
      <ListItem><Label>ValidLifetime</Label><ScriptBlock>if ($_.ValidLifetime -eq [TimeSpan]::MaxValue) { 'Infinite ([TimeSpan]::MaxValue)' } else { $_.ValidLifetime }</ScriptBlock></ListItem>
