      <ListItem><Label>PreferredLifetime</Label><ScriptBlock>if ($_.PreferredLifetime -eq [TimeSpan]::MaxValue) { 'Infinite ([TimeSpan]::MaxValue)' } else { $_.PreferredLifetime }</ScriptBlock></ListItem>
