<?xml version="1.0" encoding="utf-8"?>
<!-- Default views of the NetTCPIP objects of ReactOS-Nitro: column names, widths and alignment as measured on Windows 10. -->
<Configuration>
  <ViewDefinitions>
    <View><Name>DefaultView</Name><ViewSelectedBy>
      <TypeName>Microsoft.Management.Infrastructure.CimInstance#ROOT/StandardCimv2/MSFT_NetIPAddress</TypeName>
    </ViewSelectedBy><ListControl><ListEntries><ListEntry><ListItems>
